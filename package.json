{
  "name": "ta-llm-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website of the TA-LLM research project — Large Language Models: a matter of time?",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:dist": "node scripts/check-dist.mjs",
