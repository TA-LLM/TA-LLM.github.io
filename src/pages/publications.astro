---
import publicationsBackdrop from "../assets/backdrops/publications.webp";
import Backdrop from "../components/Backdrop.astro";
import EmptyState from "../components/EmptyState.astro";
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

type Publication = {
  title: string;
  authors: string[];
  venue: string;
  date: Date;
  status: "preprint" | "accepted" | "published";
  themes: string[];
  abstract: string;
  url?: string;
};

// Placeholder publications: replace with real entries (or move them to a content collection).
const publications: Publication[] = [
  {
    title: "Articolo A",
    authors: ["Luca Cagliero", "Lorenzo Vaiani"],
    venue: "arXiv preprint",
    date: new Date("2026-09-08"),
    status: "preprint",
    themes: ["evaluation", "reliability"],
    abstract:
      "We track how the confidence estimates of instruction-tuned models shift across successive fine-tuning rounds and propose a lightweight benchmark for detecting calibration drift before deployment.",
    url: "https://example.org/ta-llm/articolo-a",
  },
  {
    title: "Articolo B",
    authors: ["Lorenzo Vaiani", "Luca Cagliero"],
    venue: "Workshop on Multilingual NLP (fictional)",
    date: new Date("2026-09-22"),
    status: "accepted",
    themes: ["retrieval", "multilinguality"],
    abstract:
      "We study retrieval-augmented generation on small Italian corpora from the legal and healthcare sectors, showing that domain-specific rerankers cut unsupported claims by a wide margin.",
  },
  {
    title: "Articolo C",
    authors: ["Luca Cagliero", "Lorenzo Vaiani"],
    venue: "Technical report, TA-LLM project",
    date: new Date("2026-09-28"),
    status: "published",
    themes: ["reliability", "transparency"],
    abstract:
      "This report outlines the project's framework for recording, storing and inspecting the intermediate reasoning of language models so that their outputs can be audited after the fact.",
  },
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const years = [...new Set(publications.map((p) => p.date.getFullYear()))];
const themes = [...new Set(publications.flatMap((p) => p.themes))].sort();

const statusLabel = { preprint: "Preprint", accepted: "Accepted", published: "Published" };
const dateFormat = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title="Publications" description="Publications of the TA-LLM research project.">
  <Backdrop image={publicationsBackdrop} motion="push" />
  <PageIntro eyebrow="Publications" title="Publications" />
  {
    publications.length === 0 && (
      <EmptyState
        icon="paper"
        label="0 publications"
        message="The project started on 18 August 2026. Its first papers will appear here, grouped by year and filterable by theme."
        href="/research/"
        linkText="Read about the research themes"
      />
    )
  }
  {
    publications.length > 0 && (
      <div class="publications">
        <div class="filters" role="group" aria-label="Filter by theme">
          <button type="button" data-theme-filter="all" aria-pressed="true">All</button>
          {themes.map((theme) => (
            <button type="button" data-theme-filter={theme} aria-pressed="false">
              {theme}
            </button>
          ))}
        </div>

        {years.map((year) => (
          <section class="year" data-year>
            <h2>{year}</h2>
            <ol>
              {publications
                .filter((p) => p.date.getFullYear() === year)
                .map((p) => (
                  <li class="pub" data-themes={p.themes.join(",")}>
                    <p class="meta">
                      <span class="status">{statusLabel[p.status]}</span>
                      <time datetime={p.date.toISOString()}>{dateFormat.format(p.date)}</time>
                    </p>
                    <h3>{p.url ? <a href={p.url}>{p.title}</a> : p.title}</h3>
                    <p class="authors">{p.authors.join(", ")}</p>
                    <p class="venue">{p.venue}</p>
                    <p class="abstract">{p.abstract}</p>
                    <ul class="tags">
                      {p.themes.map((theme) => (
                        <li>{theme}</li>
                      ))}
                    </ul>
                  </li>
                ))}
            </ol>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-themes]");
  const years = document.querySelectorAll<HTMLElement>("[data-year]");

  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const theme = button.dataset.themeFilter!;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      items.forEach((item) => {
        item.hidden = theme !== "all" && !item.dataset.themes!.split(",").includes(theme);
      });
      years.forEach((year) => {
        year.hidden = !year.querySelector("[data-themes]:not([hidden])");
      });
    }),
  );
</script>

<style>
  .publications {
    display: grid;
    gap: 2.5rem;
    max-width: 50rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filters button {
    padding: 0.35rem 0.9rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-transform: capitalize;
    cursor: pointer;
  }

  .filters button[aria-pressed="true"] {
    background: var(--color-fg, #000);
    color: var(--color-bg, #fff);
    border-color: var(--color-fg, #000);
  }

  .filters button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .year h2 {
    margin-bottom: 1rem;
  }

  .year ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.75rem;
  }

  .pub h3 {
    margin: 0.25rem 0;
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .status {
    font-weight: 600;
  }

  .authors,
  .venue {
    margin: 0.15rem 0;
  }

  .venue {
    font-style: italic;
  }

  .abstract {
    margin: 0.5rem 0;
    max-width: 70ch;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8rem;
  }

  .tags li {
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
</style>
