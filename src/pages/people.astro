---
/**
 * People (taste.md §2.4). Researchers first, the PI leading, then the
 * postdoctoral researchers, then the PhD students in theme order. The cards form one ruled table (1px rules, no
 * shadows), each lighting up on its own. (The faint grid of the `people`
 * reference behind the page was removed at the user's request, 2026-09-19.)
 */
import { getCollection, getEntries } from "astro:content";
import Icon from "../components/Icon.astro";
import PageIntro from "../components/PageIntro.astro";
import Tag from "../components/Tag.astro";
import PersonCard from "../components/PersonCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const people = await getCollection("people");
const byOrder = (a: (typeof people)[number], b: (typeof people)[number]) => a.data.order - b.data.order;
const researchers = people.filter((p) => !["phd", "postdoc"].includes(p.data.role)).sort(byOrder);
const postdocs = people.filter((p) => p.data.role === "postdoc").sort(byOrder);
const students = people.filter((p) => p.data.role === "phd").sort(byOrder);

const withThemes = async (list: typeof people) =>
  Promise.all(
    list.map(async (person) => ({
      person,
      themes: (await getEntries(person.data.themes)).sort((a, b) => a.data.number.localeCompare(b.data.number)),
    })),
  );

const groups = [
  { id: "researchers", title: "Researchers", members: await withThemes(researchers) },
  { id: "postdocs", title: "Postdoctoral researchers", members: await withThemes(postdocs) },
  { id: "phd-students", title: "PhD students", members: await withThemes(students) },
];
---

<BaseLayout title="People" description="The researchers, postdoc and PhD students of the TA-LLM project at Politecnico di Torino.">
  <div class="team">
    <PageIntro
      eyebrow="People"
      title="The team"
      lede="Five faculty members of Politecnico di Torino lead the project, with a postdoctoral researcher. Four PhD students each take on one of its research themes."
    >
      <ul role="list" class="tags team__tags" aria-label="The team in brief">
        <li><Tag variant="solid" icon="users">5 faculty&nbsp;· 1 postdoc&nbsp;· 4 PhD students</Tag></li>
        <li><Tag icon="school">DAUIN · Politecnico di Torino</Tag></li>
        <li><Tag dot>Open to collaboration</Tag></li>
      </ul>
      <a class="label link-arrow team__join" href="/collaborate/">Work with us<Icon name="arrow-right" size={16} /></a>
    </PageIntro>

    {
      groups.map((group) => (
        <section class="container group" aria-labelledby={group.id}>
          <h2 id={group.id} class="label group__title" data-reveal>
            {group.title}
            <span class="muted">{String(group.members.length).padStart(2, "0")}</span>
          </h2>
          <ul
            role="list"
            class:list={["group__grid", `group__grid--${group.id}`]}
            style={`--count: ${group.members.length}`}
          >
            {group.members.map(({ person, themes }) => (
              <li>
                <PersonCard person={person} themes={themes} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .team {
    padding-bottom: var(--space-2xl);
  }

  .team__tags {
    margin-bottom: var(--space-s);
  }

  .team__join {
    color: var(--accent-text);
    text-decoration: none;
  }

  .group {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-xl);
  }

  .group__title {
    display: flex;
    gap: var(--space-2xs);
  }

  /* A ruled table: the grid draws its top and left rules, every card its
     right and bottom ones, so an unfinished last row leaves no filled gaps. */
  .group__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    border-top: var(--hairline) solid var(--rule);
    border-left: var(--hairline) solid var(--rule);
  }

  .group__grid > li {
    display: grid;
  }

  /* Phones: two per row, so nine people stay one short scroll. */
  @media (max-width: 39.99rem) {
    .group__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* A small group (the postdocs) keeps the researchers' card width, and the
     table is only as wide as its cards, so its rules never run on past the
     last one. */
  .group__grid--postdocs {
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    width: calc(100% / 3 * min(var(--count), 3));
  }

  @media (max-width: 39.99rem) {
    .group__grid--postdocs {
      grid-template-columns: repeat(min(var(--count), 2), minmax(0, 1fr));
      width: calc(100% / 2 * min(var(--count), 2));
    }
  }

  @media (min-width: 72rem) {
    .group__grid--postdocs {
      width: calc(100% / 5 * min(var(--count), 5));
    }

    .group__grid--researchers {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .group__grid--phd-students {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
