---
/**
 * DEV-ONLY typography test (Phase 2): the text sans, at 16px, beside the site's
 * mono label, a heading in the display face and mono metadata.
 * D6 is settled (display = Gelasio 400, Georgia's metrics; see CLAUDE.md).
 * getStaticPaths returns nothing in production, so this page is never built;
 * scripts/check-dist.mjs also fails the build if a /dev/ page or a candidate
 * font file reaches dist/.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";

/* Candidate fonts are linked, not imported: an `import` would be processed by
   the production build (and ship the files) even though this page is never
   generated. The dev server serves node_modules as-is. */
const FONT_CSS = [
  "public-sans/index.css",
  "source-sans-3/index.css",
  "ibm-plex-sans/standard.css",
  "instrument-sans/standard.css",
  "archivo/standard.css",
].map((file) => `/node_modules/@fontsource-variable/${file}`);

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { test: "type" } }] : [];
}

const SANS = {
  public: { name: "Public Sans", family: "'Public Sans Variable'", note: "wght 100–900" },
  source: { name: "Source Sans 3", family: "'Source Sans 3 Variable'", note: "wght 200–900" },
  plex: { name: "IBM Plex Sans", family: "'IBM Plex Sans Variable'", note: "wght 100–700 · wdth 75–100" },
  instrument: { name: "Instrument Sans", family: "'Instrument Sans Variable'", note: "wght 400–700 · wdth 75–100" },
  archivo: { name: "Archivo", family: "'Archivo Variable'", note: "wght 100–900 · wdth 62–125" },
} as const;
type SansKey = keyof typeof SANS;

/* ~120 words, identical in every specimen. Written for this test; facts only. */
const paragraph =
  "Language models learn from a snapshot of the world, but the world does not hold still. Sensor streams keep arriving, the meaning of words shifts, and a fact that held last spring may be wrong by autumn. TA-LLM studies how large language models can read numeric time series, reason about order and duration, cope with sources that fall out of step, and notice when their own answers start to drift. The work is organised in four themes, from feedback that adapts as models change to agents that plan over long horizons. The project runs from August 2026 to August 2029 at the Department of Control and Computer Engineering of Politecnico di Torino, funded by the Italian Ministry of University and Research.";
const wordCount = paragraph.split(/\s+/).length;
---

<BaseLayout title="Type test (dev only)">
  {FONT_CSS.map((href) => <link rel="stylesheet" href={href} />)}
  <div class="container test">
    <header class="test__intro">
      <p class="label muted">Dev only · not built in production</p>
      <h1 class="test__h1">Typography test — the text sans</h1>
    </header>

    <!-- Text sans -------------------------------------------------------- -->
    <section class="sans" aria-labelledby="sans-title">
      <h2 id="sans-title" class="label muted">
        Text sans at 16px · the same {wordCount}-word text · with a mono label, a display-face title and mono metadata
      </h2>
      <div class="sans__grid">
        {
          (Object.keys(SANS) as SansKey[]).map((key, i) => (
            <article class="specimen" style={`--specimen-sans: ${SANS[key].family}`}>
              <p class="specimen__candidate">
                {String.fromCharCode(65 + i)} · {SANS[key].name} <span class="muted">· {SANS[key].note}</span>
              </p>
              <p class="label muted specimen__label">Theme 03 · Topology-aware reasoning</p>
              <h3 class="specimen__title">Why language models lose track of time</h3>
              <p class="specimen__body">{paragraph}</p>
              <p class="specimen__meta">
                <time datetime="2027-03-12">2027-03-12</time> · SPECIMEN VENUE 2027 · DOI 10.0000/SPECIMEN.0001
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .test {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .test__h1 {
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step-1);
  }

  /* Text sans --------------------------------------------------------- */
  .sans {
    display: grid;
    gap: var(--space-m);
  }

  .sans__grid {
    display: grid;
    gap: var(--hairline);
    background: var(--rule);
    border-block: var(--hairline) solid var(--rule);
  }

  @media (min-width: 64rem) {
    .sans__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Identical padding everywhere, so every specimen has the same measure and
     the only variable is the typeface. */
  .specimen {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    padding: var(--space-m) 0 var(--space-l);
    background: var(--surface);
  }

  @media (min-width: 64rem) {
    .specimen {
      padding-inline: var(--space-l);
    }

    /* Five specimens: the last one spans the row instead of leaving an empty cell. */
    .specimen:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  /* Neutral on purpose: the only amber on the page is the "?", as in real use. */
  .specimen__candidate {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text);
    margin-bottom: var(--space-2xs);
  }

  .specimen__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .specimen__body {
    max-width: 68ch;
    font-family: var(--specimen-sans), sans-serif;
    font-size: 16px;
    line-height: 1.6;
  }

  .specimen__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
