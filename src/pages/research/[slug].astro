---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PageIntro from "../../components/PageIntro.astro";
import ThemeGlyph from "../../components/ThemeGlyph.astro";
import Todo from "../../components/Todo.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const themes = await getCollection("themes");
  return themes.map((theme) => ({ params: { slug: theme.id }, props: { theme } }));
}

interface Props {
  theme: CollectionEntry<"themes">;
}

const { theme } = Astro.props;
const { number, title, supervisor, coSupervisor, phdStudent, status, summary, colour } = theme.data;
const approved = status === "approved";
const { Content } = await render(theme);
---

<BaseLayout title={title} description={approved ? summary : undefined}>
  <PageIntro
    eyebrow={`Theme ${number}`}
    title={title}
    lede={approved ? summary : undefined}
    titleTransition={`title-${colour}`}
  >
    <span slot="mark" class="theme-mark" data-theme-key={colour} style={`view-transition-name: glyph-${colour}`}>
      <ThemeGlyph theme={colour} size={112} animated />
    </span>
  </PageIntro>

  <section class="container meta" aria-label="Supervision">
    <dl class="meta__list" data-reveal-children>
      <div>
        <dt class="label muted">Supervisor</dt>
        <dd>{supervisor}</dd>
      </div>
      <div>
        <dt class="label muted">Co-supervisor</dt>
        <dd>{coSupervisor}</dd>
      </div>
      <div>
        <dt class="label muted">PhD student</dt>
        <dd>{phdStudent ?? <Todo what="name" />}</dd>
      </div>
    </dl>
    {!approved && <p><Todo what="theme description, pending approval" /></p>}
  </section>

  {
    approved && (
      <article class="container body" data-theme-key={colour} data-reveal-children>
        <Content />
      </article>
    )
  }
</BaseLayout>

<style>
  .meta {
    display: grid;
    gap: var(--space-l);
  }

  .meta__list {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding-top: var(--space-m);
    border-top: var(--hairline) solid var(--rule);
  }

  @media (min-width: 48rem) {
    .meta__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .meta__list dt {
    margin-bottom: var(--space-3xs);
  }

  .meta__list dd {
    margin: 0;
  }

  /* The theme text: one reading column, sections separated by space and a
     hairline. Headings take the theme's text-safe colour, the one accent. */
  [data-theme-key="rlaif"] { --theme-ink: var(--theme-rlaif-ink); }
  [data-theme-key="cl"] { --theme-ink: var(--theme-cl-ink); }
  [data-theme-key="topology"] { --theme-ink: var(--theme-topology-ink); }
  [data-theme-key="agentic"] { --theme-ink: var(--theme-agentic-ink); }

  /* The glyph is this page's one accent, in the theme's text-safe colour. */
  /* Sized to the glyph, so it can travel from the /research row as itself. */
  .theme-mark {
    display: inline-block;
    color: var(--theme-ink);
  }

  .body {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .body > :global(*) {
    max-width: var(--measure);
  }

  .body :global(h2) {
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: var(--hairline) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--theme-ink);
  }

  .body :global(h2:first-child) {
    margin-top: 0;
  }

  .body :global(ul),
  .body :global(ol) {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding-left: 1.25em;
  }

  .body :global(li::marker) {
    color: var(--text-muted);
  }

  /* Bibliography: the last list, set smaller, numbered like the [n] citations. */
  .body :global(ol) {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .body :global(ol a) {
    color: var(--text);
    overflow-wrap: anywhere;
  }
</style>
