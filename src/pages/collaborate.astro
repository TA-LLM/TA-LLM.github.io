---
/**
 * Collaborate — after the `collaborate` reference (a split screen: an image
 * panel on the left, the content on the right), rebuilt for this project:
 * no sign-in form. The right column holds the invitation and the two
 * audiences of taste.md §2.3 (cards_5 grammar): researchers and companies,
 * each with a short status label with a dot, a title, two lines and one link.
 *
 * - The image (AI-generated) fills the whole page in its original colours,
 *   in both themes (user decision, 2026-09-19): no grade, no blend. On
 *   desktop it stays in place behind the page while the content scrolls
 *   over it on the left, on a veil of the page's surface that clears towards
 *   the figure on the ledge; the text may overlap the picture slightly. On
 *   phones it is a full-width opening image the content rises over.
 * - Applications go to an external PoliTo form (CLAUDE.md): no personal data
 *   is ever collected by this site. Its address, and the public contact
 *   addresses, are still to come, so those links are marked.
 */
import { Picture } from "astro:assets";
import collaborateImage from "../assets/backdrops/collaborate.webp";
import Icon from "../components/Icon.astro";
import Tag from "../components/Tag.astro";
import Todo from "../components/Todo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const audiences = [
  {
    id: "researchers",
    status: "Researchers",
    title: "Work on a theme with us",
    text: "Bring data, benchmarks or methods on time-aware language models, or propose a joint study on one of the four research themes.",
    link: { href: "/research/", label: "See the four themes" },
  },
  {
    id: "companies",
    status: "Companies",
    title: "Test a problem that changes over time",
    text: "Sensor streams, logs, documents that keep changing: real time-evolving data is where the project's methods are meant to be tried.",
    link: null,
  },
];
---

<BaseLayout title="Collaborate" description="Collaborate with TA-LLM: researchers and companies.">
  <div class="scene" aria-hidden="true">
    <figure class="scene__frame" data-media-motion="drift">
      <Picture
        src={collaborateImage}
        alt=""
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[480, 768]}
        sizes="100vw"
        loading="eager"
      />
    </figure>
  </div>

  <div class="split container">

    <div class="split__content">
      <header class="intro">
        <p class="label muted" data-reveal>Collaborate</p>
        <h1 class="intro__title" data-reveal="mask">Work with us</h1>
        <p class="intro__lede" data-reveal>
          TA-LLM studies how large language models deal with time, at Politecnico di Torino from 2026 to 2029. We welcome
          collaborations that bring data, problems or expertise to its research.
        </p>
      </header>

      <ul role="list" class="audiences">
        {
          audiences.map((a) => (
            <li class="audience" aria-labelledby={`${a.id}-title`} data-reveal>
              <p class="audience__status">
                <Tag dot>Open · {a.status}</Tag>
              </p>
              <h2 id={`${a.id}-title`} class="audience__title">
                {a.title}
              </h2>
              <p class="audience__text">{a.text}</p>
              <div class="audience__links">
                {a.link && (
                  <a class="label link-arrow audience__link" href={a.link.href}>
                    {a.link.label}
                    <Icon name="arrow-right" size={16} />
                  </a>
                )}
                <Todo what="contact address" />
              </div>
            </li>
          ))
        }
      </ul>

      <section class="apply" aria-labelledby="apply-title" data-reveal>
        <div class="apply__head">
          <h2 id="apply-title" class="label muted">Open positions</h2>
          <Tag variant="solid">Calls via Politecnico</Tag>
        </div>
        <p>
          Calls for PhD, research and visiting positions are published by Politecnico di Torino; applications are made
          there, never through this site.
        </p>
        <p><Todo what="link to the PoliTo application form and current calls" /></p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* ------------------------------------------------- the picture
     Phones: a full-width opening image, fading into the page at its foot;
     the content rises a little over it. */
  .scene {
    position: relative;
    z-index: -1;
    height: min(78dvh, 44rem);
    margin-bottom: calc(-1 * var(--space-3xl, 6rem));
  }

  .scene__frame {
    position: relative;
    height: 100%;
    margin: 0;
    overflow: hidden;
  }

  .scene__frame :global(picture),
  .scene__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The picture is clipped a few pixels short of the frame's foot, inside
     the veil's solid band: clipped at the frame's own fractional edge, the
     drifting image's last row showed past the veil as a 1px line. */
  .scene__frame :global(picture) {
    height: calc(100% - 4px);
    overflow: hidden;
  }

  .scene__frame :global(img) {
    object-fit: cover;
    object-position: 60% 72%;
    transform-origin: 66% 74%;
  }

  /* The veil: the page's own surface, so the page never shows a seam. */
  .scene__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 45%, color-mix(in srgb, var(--surface) 70%, transparent) 72%, var(--surface) 90%);
  }

  @media (forced-colors: active) {
    .scene {
      display: none;
    }
  }

  .split {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-l) var(--space-2xl);
  }

  .split__content {
    display: grid;
    align-content: start;
    gap: var(--space-xl);
    min-width: 0;
  }

  .intro {
    display: grid;
    gap: var(--space-s);
  }

  .intro__title {
    font-family: var(--font-display);
    font-size: var(--step-4);
  }

  .intro__lede {
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  /* The two audiences: a ruled list, no cards, no tints (one accent). */
  .audiences {
    display: grid;
    border-top: var(--hairline) solid var(--rule);
  }

  .audience {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-l);
    border-bottom: var(--hairline) solid var(--rule);
  }

  .audience__status {
    margin-bottom: var(--space-2xs);
  }

  .apply__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
  }

  .audience__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .audience__text {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .audience__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-2xs);
  }

  .audience__link {
    color: var(--accent-text);
    text-decoration: none;
  }

  .apply {
    display: grid;
    gap: var(--space-xs);
  }

  .apply > p {
    max-width: var(--measure);
  }

  /* Desktop: the picture fills the page and stays in place (sticky inside
     a layer as tall as <main>, so it ends with the page, never behind the
     footer); the content runs down the left over a veil of the surface that
     clears towards the figure on the right. */
  @media (min-width: 64rem) {
    .scene {
      position: absolute;
      inset: 0;
      height: auto;
      margin: 0;
    }

    .scene__frame {
      position: sticky;
      top: calc(var(--header-h) + var(--thread-h));
      height: calc(100dvh - var(--header-h) - var(--thread-h));
    }

    /* A short fade at the foot, so the picture never ends on an edge where
       the page meets the footer. The whole width of the picture shows; the slice keeps the sunset and
       the figure on the ledge in view. */
    .scene__frame :global(img) {
      object-position: 50% 80%;
    }

    .scene__frame::after {
      background:
        linear-gradient(to right, var(--surface) 0%, var(--surface) 30%, color-mix(in srgb, var(--surface) 82%, transparent) 44%, color-mix(in srgb, var(--surface) 35%, transparent) 54%, transparent 64%),
        linear-gradient(to bottom, color-mix(in srgb, var(--surface) 25%, transparent), transparent 18%, transparent 82%, var(--surface) 98%);
    }

    .split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      padding-top: var(--space-2xl);
      padding-bottom: 40dvh;
    }

    .split__content {
      grid-column: 1;
      max-width: 38rem;
    }
  }
</style>
