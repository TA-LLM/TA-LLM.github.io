---
import PageIntro from "../components/PageIntro.astro";
import InstitutionLogos from "../components/InstitutionLogos.astro";
import Icon from "../components/Icon.astro";
import Tag from "../components/Tag.astro";
import Todo from "../components/Todo.astro";
import { PROJECT } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="TA-LLM studies what large language models are missing when data moves: time series, temporal relations and content that goes out of date."
>
  <PageIntro
    eyebrow="About"
    title="About the project"
    lede="Large language models read and write fluently, and increasingly look at pictures too. They are far weaker at time: at series of numbers, at the relations that order events, at a world that keeps changing after the model was trained."
  >
    <p><Todo what="2026–2029 timeline — Phase 4" /></p>
  </PageIntro>

  <section id="vision" class="container vision" aria-labelledby="vision-title">
    <h2 id="vision-title" class="funding__title">The project</h2>
    <div class="vision__text" data-reveal-children>
      <p>
        Discovering knowledge from data is a time-dependent process, and the numeric series recorded by sensors and
        instruments only keep growing. A model that cannot read those series, or that treats every source as if it were
        written at once, misses most of what the data has to say.
      </p>
      <p>
        TA-LLM sets out to make language models aware of time. It studies what a model can learn from timestamped values,
        how it is affected when the parts of a multimodal source drift apart, and how a system built on it can notice that
        its answers have gone out of date — and correct them.
      </p>
    </div>
    <a class="label link-arrow vision__link" href="/research/" data-reveal>
      The four research themes<Icon name="arrow-right" size={16} />
    </a>
  </section>

  <section id="goals" class="container goals" aria-labelledby="goals-title">
    <h2 id="goals-title" class="funding__title">Three goals</h2>
    <ol role="list" class="goals__list">
      <li class="goal" data-reveal>
        <p class="label muted goal__number">01</p>
        <h3 class="goal__title">Time series a model can actually use</h3>
        <p class="goal__text">
          Designing and testing LLM-based approaches — in-context learning, parameter-efficient and lightweight
          fine-tuning — that draw out what is hidden in timestamped series of numbers.
        </p>
      </li>
      <li class="goal" data-reveal>
        <p class="label muted goal__number">02</p>
        <h3 class="goal__title">Sources that do not line up in time</h3>
        <p class="goal__text">
          In lecture recordings, news streams and podcasts, picture, words and sound are often out of step. The project
          measures how much that misalignment costs a model, then designs ways to make up for it.
        </p>
      </li>
      <li class="goal" data-reveal>
        <p class="label muted goal__number">03</p>
        <h3 class="goal__title">Systems that keep up with change</h3>
        <p class="goal__text">
          Summarisation, question answering and intent recognition, rebuilt as time-aware tasks, with systems that detect
          drifts or inconsistencies in what a model returns and act on them.
        </p>
      </li>
    </ol>
  </section>

  <section id="funding" class="container funding" aria-labelledby="funding-title">
    <h2 id="funding-title" class="funding__title">Funding</h2>
    <ul role="list" class="tags" aria-label="Funding in brief" data-reveal>
      <li><Tag variant="solid" icon="landmark">MUR · FIS 2</Tag></li>
      <li><Tag icon="hash">{PROJECT.code}</Tag></li>
      <li><Tag icon="calendar-range">36 months</Tag></li>
    </ul>
    <dl class="funding__list" data-reveal>
      <div><dt class="label muted"><Icon name="landmark" size={18} />Funder</dt><dd>{PROJECT.funder}</dd></div>
      <div><dt class="label muted"><Icon name="award" size={18} />Programme</dt><dd>{PROJECT.programme}</dd></div>
      <div><dt class="label muted"><Icon name="hash" size={18} />Project code</dt><dd class="mono">{PROJECT.code}</dd></div>
      <div><dt class="label muted"><Icon name="receipt" size={18} />CUP</dt><dd class="mono">{PROJECT.cup}</dd></div>
      <div>
        <dt class="label muted"><Icon name="calendar-range" size={18} />Duration</dt>
        <dd class="mono">
          <time datetime={PROJECT.start}>18/08/2026</time> – <time datetime={PROJECT.end}>17/08/2029</time>
        </dd>
      </div>
      <div>
        <dt class="label muted"><Icon name="building" size={18} />Host</dt>
        <dd>{PROJECT.host}</dd>
      </div>
      <div><dt class="label muted"><Icon name="user" size={18} />Principal investigator</dt><dd>Luca Cagliero</dd></div>
    </dl>
    <InstitutionLogos class="funding__logos" size={6.5} />
    <p><Todo what="mandatory attribution wording, logos and scholarship funding (DAUIN) to be verified with Politecnico" /></p>
  </section>

  <section id="credits" class="container credits" aria-labelledby="credits-title">
    <h2 id="credits-title" class="funding__title">Credits</h2>
    <ul role="list" class="credits__list">
      <li>
        Icons from <a href="https://lucide.dev">Lucide</a>, ISC licence, © Lucide Icons and Contributors. The GitHub mark
        from <a href="https://simpleicons.org">Simple Icons</a> (CC0); it remains a trademark of GitHub, Inc.
      </li>
      <li>
        Page photographs from <a href="https://www.pexels.com">Pexels</a>, under the Pexels licence; other images and the
        hero video are AI-generated for this project.
      </li>
    </ul>
  </section>

</BaseLayout>

<style>
  .funding {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-xl);
  }

  .credits {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-xl) 0;
  }

  .credits__list {
    display: grid;
    gap: var(--space-xs);
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .vision {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-l);
  }

  .vision__text {
    display: grid;
    gap: var(--space-s);
    max-width: var(--measure);
    font-size: var(--step-0);
  }

  .vision__link {
    justify-self: start;
    color: var(--accent-text);
    text-decoration: none;
  }

  /* The three goals as a ruled table, like the themes list: a number, a
     title and two lines, no cards. */
  .goals {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-xl);
  }

  .goals__list {
    display: grid;
    border-top: var(--hairline) solid var(--rule);
  }

  .goal {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-l);
    border-bottom: var(--hairline) solid var(--rule);
  }

  .goal__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .goal__text {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  @media (min-width: 48rem) {
    .goal {
      grid-template-columns: 4rem minmax(0, 1fr);
      column-gap: var(--space-m);
    }

    .goal__number {
      grid-row: 1 / span 2;
      padding-top: 0.35em;
    }
  }

  .funding__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
  }

  .funding__list {
    display: grid;
    gap: var(--hairline);
    margin: 0;
    background: var(--rule);
    border-block: var(--hairline) solid var(--rule);
  }

  .funding__list > div {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-s);
    background: var(--surface);
  }

  @media (min-width: 48rem) {
    .funding__list > div {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-m);
      align-items: baseline;
    }
  }

  /* Each fact led by its pictogram, so the list scans by kind. */
  .funding__list dt {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .funding__list dd {
    margin: 0;
  }

  .funding__logos {
    padding-block: var(--space-s);
  }

  .mono {
    font-family: var(--font-mono);
  }
</style>
