---
import PageIntro from "../components/PageIntro.astro";
import Todo from "../components/Todo.astro";
import { PROJECT } from "../config/site";
import { RING } from "../data/electricity-ring";
import BaseLayout from "../layouts/BaseLayout.astro";

const lastDay = new Date(`${RING.last}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title="About" description="About the TA-LLM project: funding, host institution, timeline.">
  <PageIntro eyebrow="About" title="About the project">
    <p><Todo what="project overview and 2026–2029 timeline — Phase 4" /></p>
  </PageIntro>

  <section id="funding" class="container funding" aria-labelledby="funding-title">
    <h2 id="funding-title" class="funding__title">Funding</h2>
    <dl class="funding__list">
      <div><dt class="label muted">Funder</dt><dd>{PROJECT.funder}</dd></div>
      <div><dt class="label muted">Programme</dt><dd>{PROJECT.programme}</dd></div>
      <div><dt class="label muted">Project code</dt><dd class="mono">{PROJECT.code}</dd></div>
      <div><dt class="label muted">CUP</dt><dd class="mono">{PROJECT.cup}</dd></div>
      <div>
        <dt class="label muted">Duration</dt>
        <dd class="mono">
          <time datetime={PROJECT.start}>18/08/2026</time> – <time datetime={PROJECT.end}>17/08/2029</time>
        </dd>
      </div>
      <div><dt class="label muted">Host</dt><dd>{PROJECT.host}</dd></div>
      <div><dt class="label muted">Principal investigator</dt><dd>Luca Cagliero</dd></div>
    </dl>
    <p><Todo what="mandatory attribution wording, logos and scholarship funding (DAUIN) to be verified with Politecnico" /></p>
  </section>

  <section id="hero-data" class="container funding" aria-labelledby="hero-data-title">
    <h2 id="hero-data-title" class="funding__title">The data in the home-page ring</h2>
    <p class="hero-data__text">
      The ring on the home page is drawn from real measurements: the total electricity demand of
      {RING.clients} clients in Portugal, one ring per day, for the last {RING.days.length} complete days of the
      dataset. The amber ring is <time datetime={RING.last}>{lastDay}</time>, the final day in the data —
      not today's date.
    </p>
    <dl class="funding__list">
      <div><dt class="label muted">Dataset</dt><dd>ElectricityLoadDiagrams20112014</dd></div>
      <div>
        <dt class="label muted">Citation</dt>
        <dd>
          Trindade, A. (2015). ElectricityLoadDiagrams20112014 [Dataset]. UCI Machine Learning Repository.
          <a href={`https://doi.org/${RING.doi}`}>https://doi.org/{RING.doi}</a>
        </dd>
      </div>
      <div>
        <dt class="label muted">Licence</dt>
        <dd><a href="https://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution 4.0 (CC BY 4.0)</a></dd>
      </div>
      <div>
        <dt class="label muted">Changes made</dt>
        <dd>
          Clients summed into total demand; 15-minute readings averaged into 30-minute values; values normalised to
          the window's range ({RING.minKw.toLocaleString("en-GB")}–{RING.maxKw.toLocaleString("en-GB")} kW).
        </dd>
      </div>
      <div>
        <dt class="label muted">Period shown</dt>
        <dd class="mono">
          <time datetime={RING.first}>{RING.first}</time> – <time datetime={RING.last}>{RING.last}</time>
        </dd>
      </div>
    </dl>
  </section>
</BaseLayout>

<style>
  .funding {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-xl);
  }

  .funding__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
  }

  .funding__list {
    display: grid;
    gap: var(--hairline);
    margin: 0;
    background: var(--rule);
    border-block: var(--hairline) solid var(--rule);
  }

  .funding__list > div {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-s);
    background: var(--surface);
  }

  @media (min-width: 48rem) {
    .funding__list > div {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-m);
      align-items: baseline;
    }
  }

  .funding__list dd {
    margin: 0;
  }

  .hero-data__text {
    max-width: var(--measure);
  }

  .mono {
    font-family: var(--font-mono);
  }
</style>
