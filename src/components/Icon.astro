---
/**
 * A utility icon from src/icons/icons.ts. Decorative by default (hidden from
 * assistive technology, the text beside it carries the meaning); pass `label`
 * only when the icon stands alone.
 */
import { ICONS, type IconName } from "../icons/icons";

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 20 20"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={ICONS[name]}
/>

<style>
  .icon {
    flex: none;
    vertical-align: middle;
  }
</style>
