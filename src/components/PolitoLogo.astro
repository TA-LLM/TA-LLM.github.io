---
/**
 * Politecnico di Torino logo (the 2021 horizontal mark, from the file supplied
 * by the project). The artwork is one colour on transparency, so it is drawn
 * as a CSS mask filled with a token: the official blue (#003054, sampled from
 * the file) on paper, and a negative in paper on ink, where the blue would
 * fall to about 1.3:1. The artwork itself is never altered or recoloured.
 * In forced-colours mode it takes the system text colour, so it never
 * disappears. The source is pre-sized (800px, WebP, full-quality alpha) from
 * the supplied original, so it ships as a single file.
 */
import logo from "../assets/brand/polito-logo.webp";

interface Props {
  /** Rendered height; the width follows the artwork's proportions. */
  height?: string;
  class?: string;
}

const { height = "3.5rem", class: className } = Astro.props;
---

<a class:list={["polito", className]} href="https://www.polito.it/">
  <span
    class="polito__mark"
    role="img"
    aria-label="Politecnico di Torino"
    style={`--logo: url(${logo.src}); --logo-ratio: ${(logo.width / logo.height).toFixed(4)}; --logo-h: ${height}`}
  ></span>
</a>

<style>
  .polito {
    display: inline-block;
    line-height: 0;
  }

  .polito__mark {
    display: block;
    height: var(--logo-h);
    aspect-ratio: var(--logo-ratio);
    background: var(--institution-mark);
    mask: var(--logo) center / contain no-repeat;
  }

  @media (forced-colors: active) {
    .polito__mark {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }
</style>
