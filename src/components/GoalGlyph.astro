---
/**
 * One of three drawings made for the project's three goals (Home). Each one
 * states its goal's problem rather than decorating it — the site's second
 * motion layer, "animated inline SVG where the movement is the subject"
 * (CLAUDE.md), the same 1.5px non-scaling stroke as the theme glyphs.
 *
 * - `series`: a numeric time series, its samples marked, read from left to
 *   right — the knowledge hidden in timestamped values.
 * - `misalignment`: three tracks (picture, words, sound) that drift out of
 *   step around one instant, then fall back in.
 * - `model-and-time`: the model itself — a small network in its frame —
 *   beside the site's own hourglass (the icon set's, enlarged), its sand
 *   amber and running. A dotted line carries time into the model, one grain
 *   at a time: an LLM put next to the thing it has to understand.
 *
 * Neutral except for one amber accent per drawing (the samples, the instant,
 * the mark). Drawn once the goal is revealed; the loops run only under
 * `prefers-reduced-motion: no-preference`, and stop when the goal is not on
 * screen (the Home section observes them). Decorative: the goal's text
 * carries the meaning.
 */
interface Props {
  kind: "series" | "misalignment" | "model-and-time";
  class?: string;
}

const { kind, class: className } = Astro.props;

/** The series: sampled values, drawn as a path and as its sample marks. */
const samples: [number, number][] = [
  [12, 48],
  [28, 32],
  [44, 40],
  [60, 20],
  [76, 36],
  [92, 26],
  [108, 46],
  [124, 28],
  [140, 38],
  [156, 22],
  [172, 34],
  [188, 28],
];
const seriesPath = samples.map(([x, y], i) => `${i === 0 ? "M" : "L"}${x} ${y}`).join("");
---

<svg
  class:list={["glyph", `glyph--${kind}`, className]}
  viewBox="0 0 200 72"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  vector-effect="non-scaling-stroke"
  aria-hidden="true"
  focusable="false"
>
  {
    kind === "series" && (
      <>
        <path class="glyph__rule" d="M8 62h184" />
        <path class="glyph__line" d={seriesPath} pathLength="1" />
        {samples.map(([x, y], i) => (
          <circle class="glyph__dot" cx={x} cy={y} r="2.4" style={`--i: ${i}`} />
        ))}
      </>
    )
  }

  {
    kind === "misalignment" && (
      <>
        <path class="glyph__instant" d="M100 8v56" stroke-dasharray="3 5" />
        {[
          { y: 18, shift: -18 },
          { y: 36, shift: 10 },
          { y: 54, shift: -6 },
        ].map((track, i) => (
          <path class="glyph__track" d={`M40 ${track.y}h120`} style={`--shift: ${track.shift}; --i: ${i}`} />
        ))}
      </>
    )
  }

  {
    kind === "model-and-time" && (
      <>
        {/* The model: a network inside its frame. */}
        <rect class="glyph__frame" x="10" y="14" width="80" height="44" rx="8" />
        <path class="glyph__wires" d="M30 26L54 30M30 26L54 42M30 46L54 30M30 46L54 42M54 30L72 36M54 42L72 36" />
        {[
          [30, 26],
          [30, 46],
          [54, 30],
          [54, 42],
          [72, 36],
        ].map(([x, y]) => (
          <circle class="glyph__node" cx={x} cy={y} r="2.6" />
        ))}

        {/* Time, carried into it grain by grain. */}
        <path class="glyph__feed" d="M118 36H96" stroke-dasharray="2 5" />

        {/* The site's hourglass, enlarged; its sand is the one accent. */}
        <g transform="translate(122 8) scale(2.9)" stroke-width="0.52">
          <path class="glyph__glass" d="M5 2.5h10M5 17.5h10" />
          <path class="glyph__glass" d="M6.5 2.5c0 4 7 4.5 7 7.5s-7 3.5-7 7.5M13.5 2.5c0 4-7 4.5-7 7.5s7 3.5 7 7.5" />
          <path class="glyph__sand" d="M7.3 5.9c1.6 1.4 3.8 1.4 5.4 0L10 10.1z" />
          <path class="glyph__fall" d="M10 10.5v4.3" />
          <path class="glyph__sand" d="M7 16.1c1.2-2.6 4.8-2.6 6 0z" />
        </g>
      </>
    )
  }

  </svg>

<style>
  .glyph {
    display: block;
    width: 100%;
    max-width: 13rem;
    height: auto;
    color: var(--text-muted);
    overflow: visible;
  }

  .glyph__rule,
  .glyph__axis {
    stroke: var(--rule-strong);
  }

  /* The model's frame and wires, and the glass: never the accent. */
  .glyph__frame {
    stroke: var(--text-muted);
  }

  .glyph__glass {
    stroke: currentColor;
  }

  .glyph__wires,
  .glyph__feed {
    stroke: var(--rule-strong);
  }

  .glyph__node {
    fill: var(--surface);
    stroke: var(--text-muted);
  }

  /* The one accent in each drawing. */
  .glyph__dot,
  .glyph__instant,
  .glyph__fall {
    stroke: var(--accent-text);
  }

  /* The sand reads at a glance only as a solid: filled, not drawn. */
  .glyph__sand {
    fill: var(--accent-text);
    stroke: none;
  }

  .glyph__dot {
    fill: var(--surface);
  }

  /* Hidden until the goal is revealed, then drawn left to right. */
  :global(html.motion) [data-reveal]:not(.is-revealed) .glyph__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(html.motion) [data-reveal]:not(.is-revealed) :is(.glyph__dot, .glyph__node, .glyph__sand, .glyph__fall) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .glyph__line {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1400ms var(--ease) 120ms;
    }

    .glyph__dot {
      opacity: 1;
      transition: opacity 400ms var(--ease) calc(320ms + var(--i) * 90ms);
    }

    .glyph__mark {
      opacity: 1;
      transition: opacity 500ms var(--ease) 1200ms;
    }

    /* The network lights up, then the sand starts to run. */
    .glyph__node {
      opacity: 1;
      transition: opacity 500ms var(--ease) 400ms;
    }

    .glyph__sand,
    .glyph__fall {
      opacity: 1;
      transition: opacity 600ms var(--ease) 900ms;
    }

    /* Then each drawing keeps its own slow movement, which runs only while
       the section is on screen (`data-glyphs-live`). */
    :global([data-glyphs-live]) .glyph--misalignment .glyph__track {
      animation: goal-slip 14s var(--ease) infinite alternate;
      animation-delay: calc(var(--i) * -3s);
    }

    /* The sand keeps falling, and time keeps being carried into the model. */
    :global([data-glyphs-live]) .glyph--model-and-time .glyph__fall {
      animation: goal-fall 1.6s linear infinite;
    }

    :global([data-glyphs-live]) .glyph--model-and-time .glyph__feed {
      animation: goal-feed 3.2s linear infinite;
    }

    :global([data-glyphs-live]) .glyph--series .glyph__dot {
      animation: goal-sample 9s var(--ease) infinite;
      animation-delay: calc(var(--i) * 140ms);
    }
  }

  /* The three tracks slide out of step around the instant, then back. */
  @keyframes goal-slip {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(var(--shift) * 1px));
    }
  }

  /* A grain falls through the neck, over and over. */
  @keyframes goal-fall {
    from {
      stroke-dasharray: 1.1 3.1;
      stroke-dashoffset: 4.2;
    }
    to {
      stroke-dasharray: 1.1 3.1;
      stroke-dashoffset: 0;
    }
  }

  /* ...and time is carried from the glass into the model. */
  @keyframes goal-feed {
    from {
      stroke-dashoffset: 14;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* One sample at a time lights up, as the series is read. */
  @keyframes goal-sample {
    0%,
    88%,
    100% {
      fill: var(--surface);
    }
    94% {
      fill: var(--accent-text);
    }
  }

  @media (forced-colors: active) {
    .glyph {
      display: none;
    }
  }
</style>
