---
/**
 * One of three drawings made for the project's three goals (Home). Each one
 * states its goal's problem rather than decorating it — the site's second
 * motion layer, "animated inline SVG where the movement is the subject"
 * (CLAUDE.md), the same 1.5px non-scaling stroke as the theme glyphs.
 *
 * - `series`: a numeric time series, its samples marked, read from left to
 *   right — the knowledge hidden in timestamped values.
 * - `misalignment`: three tracks (picture, words, sound) that drift out of
 *   step around one instant, then fall back in.
 * - `model-and-time`: the sum written out, as the user asked (2026-09-20):
 *   their two reference marks — the LLM plate wired into a brain, and a
 *   solid hourglass — stand side by side on one line, a plus between them and
 *   a merge arrow after them (the plus sits exactly midway between the two,
 *   strokes counted), and the
 *   result follows: an hourglass whose upper chamber holds the brain, its
 *   knowledge falling as amber sand into the chamber below. The references
 *   are redrawn in the site's line, their black taken to the page's own text
 *   colour and the sand to amber; it is wider than the other two drawings,
 *   so it takes the whole column.
 *
 * Neutral except for one amber accent per drawing (the samples, the instant,
 * the mark). Drawn once the goal is revealed; the loops run only under
 * `prefers-reduced-motion: no-preference`, and stop when the goal is not on
 * screen (the Home section observes them). Decorative: the goal's text
 * carries the meaning.
 */
interface Props {
  kind: "series" | "misalignment" | "model-and-time";
  class?: string;
}

const { kind, class: className } = Astro.props;

/** The series: sampled values, drawn as a path and as its sample marks. */
const samples: [number, number][] = [
  [12, 48],
  [28, 32],
  [44, 40],
  [60, 20],
  [76, 36],
  [92, 26],
  [108, 46],
  [124, 28],
  [140, 38],
  [156, 22],
  [172, 34],
  [188, 28],
];
const seriesPath = samples.map(([x, y], i) => `${i === 0 ? "M" : "L"}${x} ${y}`).join("");
---

<svg
  class:list={["glyph", `glyph--${kind}`, className]}
  viewBox={kind === "model-and-time" ? "0 0 340 100" : "0 0 200 72"}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  vector-effect="non-scaling-stroke"
  aria-hidden="true"
  focusable="false"
>
  {
    kind === "series" && (
      <>
        <path class="glyph__rule" d="M8 62h184" />
        <path class="glyph__line" d={seriesPath} pathLength="1" />
        {samples.map(([x, y], i) => (
          <circle class="glyph__dot" cx={x} cy={y} r="2.4" style={`--i: ${i}`} />
        ))}
      </>
    )
  }

  {
    kind === "misalignment" && (
      <>
        <path class="glyph__instant" d="M100 8v56" stroke-dasharray="3 5" />
        {[
          { y: 18, shift: -18 },
          { y: 36, shift: 10 },
          { y: 54, shift: -6 },
        ].map((track, i) => (
          <path class="glyph__track" d={`M40 ${track.y}h120`} style={`--shift: ${track.shift}; --i: ${i}`} />
        ))}
      </>
    )
  }

  {
    kind === "model-and-time" && (
      <>
        {/* 1. The model: a brain wired to its leads, carrying the LLM plate. */}
        <g class="fx-llm" transform="translate(0 12)">
          <path
            class="fx-stroke"
            d="M52 16c-6-7-19-5-21 3-9 0-14 8-10 14-8 4-8 14 0 18-3 9 5 16 13 14 3 7 13 8 18 2M52 16c6-7 19-5 21 3 9 0 14 8 10 14 8 4 8 14 0 18 3 9-5 16-13 14-3 7-13 8-18 2M52 16v51"
          />
          <path class="fx-trace" d="M40 26v8h7M64 26v8h-7M38 58v-7h8M66 58v-7h-8" />
          <path class="fx-lead" d="M31 19l-9-8M73 19l9-8M21 33h-9M83 33h9M24 57l-9 7M80 57l9 7" />
          {[
            [20, 10],
            [84, 10],
            [10, 33],
            [94, 33],
            [13, 66],
            [91, 66],
            [47, 34],
            [57, 34],
            [46, 51],
            [58, 51],
          ].map(([x, y]) => (
            <circle class="fx-node" cx={x} cy={y} r="2.6" />
          ))}
          <rect class="fx-plate" x="30" y="34" width="44" height="17" rx="1.5" />
          <text class="fx-plate-text" x="52" y="47" text-anchor="middle">
            LLM
          </text>
        </g>

        {/* ...plus time. */}
        <path class="fx-plus" d="M107.7 50h16M115.7 42v16" />

        {/* 2. Time: the hourglass of the reference, solid. */}
        <g class="fx-glass" transform="translate(12 0)">
          <rect class="fx-fill" x="122" y="14" width="46" height="8" rx="1.5" />
          <rect class="fx-fill" x="122" y="78" width="46" height="8" rx="1.5" />
          <path class="fx-thick" d="M129 22c0 13 16 15 16 28s-16 15-16 28M161 22c0 13-16 15-16 28s16 15 16 28" />
          <path class="fx-sand" d="M131 30c8 6 20 5 28-2-3 8-8 11-14 16-6-5-11-8-14-14z" />
          <path class="fx-sand" d="M131 77c0-11 6-16 14-16s14 5 14 16z" />
        </g>

        {/* 3. The two joining, after the reference's merge arrow. */}
        <g class="fx-merge" transform="translate(12 0)">
          <path class="fx-strand" d="M186 30c12 0 12 20 24 20" />
          <path class="fx-strand fx-strand--accent" d="M186 70c12 0 12-20 24-20" />
          <path class="fx-strand fx-strand--accent" d="M210 50h12" />
          <path class="fx-strand fx-strand--accent" d="M216 43l8 7-8 7" />
        </g>

        {/* 4. The result: the brain inside the glass, falling as sand. */}
        <g class="fx-fusion" transform="translate(12 0)">
          <rect class="fx-fill" x="238" y="10" width="72" height="8" rx="1.5" />
          <rect class="fx-fill" x="238" y="82" width="72" height="8" rx="1.5" />
          <path class="fx-thick" d="M247 18c0 16 27 20 27 32s-27 16-27 32M301 18c0 16-27 20-27 32s27 16 27 32" />
          <path
            class="fx-stroke"
            d="M274 24c-4-5-13-3-14 2-6 0-9 6-7 9-5 3-5 9 0 12 2 5 8 8 13 5M274 24c4-5 13-3 14 2 6 0 9 6 7 9 5 3 5 9 0 12-2 5-8 8-13 5M274 24v28"
          />
          <path class="fx-fall" d="M274 56v10" />
          <path class="fx-sand" d="M258 81c0-11 7-16 16-16s16 5 16 16z" />
          <path class="fx-lead" d="M247 30h-9M301 30h9M249 70h-9M299 70h9" />
          {[
            [236, 30],
            [312, 30],
            [236, 70],
            [312, 70],
          ].map(([x, y]) => (
            <circle class="fx-node" cx={x} cy={y} r="2.6" />
          ))}
        </g>
      </>
    )
  }

  </svg>

<style>
  /* Every drawing is set to the same height, whatever its viewBox, so the
     three sit on the section's one rule; the sum is simply wider. */
  .glyph {
    display: block;
    width: auto;
    max-width: 100%;
    height: 100%;
    color: var(--text-muted);
    overflow: visible;
  }

  /* The references redrawn: their black becomes the page's text colour,
     their solids are filled with it, the sand keeps the one accent. */
  .fx-stroke,
  .fx-thick,
  .fx-trace,
  .fx-lead,
  .fx-plate,
  .fx-strand {
    stroke: var(--text);
  }

  .fx-stroke,
  .fx-plate {
    stroke-width: 1.8;
  }

  .fx-trace,
  .fx-lead {
    stroke-width: 1.6;
  }

  .fx-thick {
    stroke-width: 4.5;
  }

  .fx-strand {
    stroke-width: 3.6;
  }

  .fx-plus {
    stroke: var(--text);
    stroke-width: 3.2;
  }

  .fx-strand--accent {
    stroke: var(--accent-text);
  }

  .fx-fill {
    fill: var(--text);
    stroke: none;
  }

  .fx-node {
    fill: var(--surface);
    stroke: var(--text);
    stroke-width: 1.6;
  }

  .fx-plate {
    fill: var(--surface);
  }

  .fx-plate-text {
    fill: var(--text);
    stroke: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .fx-sand {
    fill: var(--accent-text);
    stroke: none;
  }

  .fx-fall {
    stroke: var(--accent-text);
    stroke-width: 2.4;
  }

  .glyph__rule,
  .glyph__axis {
    stroke: var(--rule-strong);
  }

  /* The model's frame and wires, and the glass: never the accent. */
  .glyph__frame,
  .glyph__plate {
    stroke: var(--text-muted);
  }

  /* The plate is solid, so the sand falls behind it, not through it. */
  .glyph__plate {
    fill: var(--surface);
  }

  .glyph__mark-text {
    fill: var(--text);
    stroke: none;
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.06em;
  }

  .glyph__glass {
    stroke: currentColor;
  }

  .glyph__wires,
  .glyph__feed {
    stroke: var(--rule-strong);
  }

  .glyph__node {
    fill: var(--surface);
    stroke: var(--text-muted);
  }

  /* The one accent in each drawing. */
  .glyph__dot,
  .glyph__instant,
  .glyph__fall {
    stroke: var(--accent-text);
  }

  /* The sand reads at a glance only as a solid: filled, not drawn. */
  .glyph__sand {
    fill: var(--accent-text);
    stroke: none;
  }

  .glyph__dot {
    fill: var(--surface);
  }

  /* Hidden until the goal is revealed, then drawn left to right. */
  :global(html.motion) [data-reveal]:not(.is-revealed) .glyph__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(html.motion) [data-reveal]:not(.is-revealed) :is(.glyph__dot, .fx-glass, .fx-merge, .fx-fusion) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .glyph__line {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1400ms var(--ease) 120ms;
    }

    .glyph__dot {
      opacity: 1;
      transition: opacity 400ms var(--ease) calc(320ms + var(--i) * 90ms);
    }

    /* The sum is read in order: the model, then time, then the result. */
    .fx-glass {
      opacity: 1;
      transition: opacity 500ms var(--ease) 500ms;
    }

    .fx-merge {
      opacity: 1;
      transition: opacity 500ms var(--ease) 900ms;
    }

    .fx-fusion {
      opacity: 1;
      transition: opacity 700ms var(--ease) 1300ms;
    }

    /* Then each drawing keeps its own slow movement, which runs only while
       the section is on screen (`data-glyphs-live`). */
    :global([data-glyphs-live]) .glyph--misalignment .glyph__track {
      animation: goal-slip 14s var(--ease) infinite alternate;
      animation-delay: calc(var(--i) * -3s);
    }

    /* In the result, the sand keeps falling out of the brain. */
    :global([data-glyphs-live]) .glyph--model-and-time .fx-fall {
      animation: goal-fall 1.8s linear infinite;
    }

    :global([data-glyphs-live]) .glyph--series .glyph__dot {
      animation: goal-sample 9s var(--ease) infinite;
      animation-delay: calc(var(--i) * 140ms);
    }
  }

  /* The three tracks slide out of step around the instant, then back. */
  @keyframes goal-slip {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(var(--shift) * 1px));
    }
  }

  /* A grain falls out of the model, over and over. */
  @keyframes goal-fall {
    from {
      stroke-dasharray: 2 4;
      stroke-dashoffset: 6;
    }
    to {
      stroke-dasharray: 2 4;
      stroke-dashoffset: 0;
    }
  }

  /* One sample at a time lights up, as the series is read. */
  @keyframes goal-sample {
    0%,
    88%,
    100% {
      fill: var(--surface);
    }
    94% {
      fill: var(--accent-text);
    }
  }

  @media (forced-colors: active) {
    .glyph {
      display: none;
    }
  }
</style>
