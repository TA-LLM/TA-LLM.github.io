---
/**
 * A full-page picture (first used on Collaborate): an AI-generated image in
 * its original colours, unblended, in both themes (user decision,
 * 2026-09-19).
 *
 * - Desktop: it fills the page and stays in place (sticky inside a layer as
 *   tall as <main>, so it ends with the page, never behind the footer); the
 *   page's content runs down the left over a veil of the surface that clears
 *   towards the subject on the right. The text may overlap it slightly.
 * - Phones: a full-width opening image fading into the page at its foot; the
 *   content rises a little over it.
 * - The veil is the page's own surface, so the page never shows a seam.
 * - `fit`: `cover` fills the page's width (a landscape slice of the
 *   picture); `height` sets the picture at the screen's height on the right,
 *   so a portrait picture shows almost whole (its left edge fading into the
 *   page), at a light `zoom` (1 = whole height).
 * - `coverWidth` (fit `cover`, desktop) narrows the picture to a fraction of
 *   the page and pushes it to the right, its left edge staying under the
 *   veil's solid band: a smaller picture, further from the text.
 * - `position` / `mobilePosition` frame the subject (object-position);
 *   `origin` is where its slow movement centres (media-motion.ts).
 * - Decorative: hidden from assistive technology; hidden in forced colours.
 *
 * Place it first inside <BaseLayout>; <main> is the positioning context.
 * Wrap the page's blocks in `.scene-content` to keep them to the left on
 * desktop (Collaborate lays out its own split instead).
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  image: ImageMetadata;
  position?: string;
  mobilePosition?: string;
  origin?: string;
  motion?: "flow" | "push" | "turn" | "drift";
  /** How far the veil reaches: `wide` for pages of text, `narrow` for a
      short page whose subject sits near the middle of the picture. */
  veil?: "wide" | "narrow";
  fit?: "cover" | "height";
  zoom?: number;
  coverWidth?: number;
}

const {
  image,
  position = "50% 50%",
  mobilePosition = "50% 50%",
  origin = "50% 50%",
  motion,
  veil = "wide",
  fit = "cover",
  zoom = 1,
  coverWidth = 1,
} = Astro.props;
const ratio = (image.width / image.height).toFixed(4);
---

<div
  class:list={["scene", `scene--${veil}`, `scene--fit-${fit}`]}
  aria-hidden="true"
  style={`--scene-position: ${position}; --scene-position-mobile: ${mobilePosition}; --scene-origin: ${origin}; --scene-ratio: ${ratio}; --scene-zoom: ${zoom}; --scene-cover: ${coverWidth}`}
>
  <figure class="scene__frame" data-media-motion={motion}>
    <Picture
      src={image}
      alt=""
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[480, 800, 1200, 1600, 2400].filter((w) => w <= image.width)}
      sizes="100vw"
      loading="eager"
    />
  </figure>
</div>

<style>
  .scene {
    position: relative;
    z-index: -1;
    height: min(78dvh, 44rem);
    margin-bottom: calc(-1 * var(--space-3xl));
  }

  .scene__frame {
    position: relative;
    height: 100%;
    margin: 0;
    overflow: hidden;
  }

  .scene__frame :global(picture),
  .scene__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The picture is clipped a few pixels short of the frame's foot, inside
     the veil's solid band: clipped at the frame's own fractional edge, the
     drifting image's last row showed past the veil as a 1px line. */
  .scene__frame :global(picture) {
    height: calc(100% - 4px);
    overflow: hidden;
  }

  .scene__frame :global(img) {
    object-fit: cover;
    object-position: var(--scene-position-mobile);
    transform-origin: var(--scene-origin);
  }

  .scene__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 45%,
      color-mix(in srgb, var(--surface) 70%, transparent) 72%,
      var(--surface) 90%
    );
  }

  @media (forced-colors: active) {
    .scene {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .scene {
      position: absolute;
      inset: 0;
      height: auto;
      margin: 0;
    }

    .scene__frame {
      position: sticky;
      top: calc(var(--header-h) + var(--thread-h));
      height: calc(100dvh - var(--header-h) - var(--thread-h));
    }

    /* The whole width of the picture shows; `position` picks the slice. */
    .scene__frame :global(img) {
      object-position: var(--scene-position);
    }

    /* Solid under the text on the left, clear on the right; a light touch
       under the header, and a short fade at the foot so the picture never
       ends on an edge where the page meets the footer. The narrow veil
       clears sooner, for a short page whose subject sits near the middle;
       it is for dark pictures on ink only: over paper, text past the solid
       band would sit on the picture's dark tones, so the light theme keeps
       the wide veil. */
    .scene {
      --veil-foot: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--surface) 12%, transparent),
        transparent 14%,
        transparent 82%,
        var(--surface) 98%
      );
      --veil-wide: linear-gradient(
        to right,
        var(--surface) 0%,
        var(--surface) 30%,
        color-mix(in srgb, var(--surface) 82%, transparent) 44%,
        color-mix(in srgb, var(--surface) 35%, transparent) 54%,
        transparent 64%
      );
      --veil-narrow: linear-gradient(
        to right,
        var(--surface) 0%,
        var(--surface) 20%,
        color-mix(in srgb, var(--surface) 80%, transparent) 32%,
        color-mix(in srgb, var(--surface) 35%, transparent) 42%,
        transparent 52%
      );
      --veil: var(--veil-wide);
    }

    .scene--narrow {
      --veil: var(--veil-narrow);
    }

    :global(:root[data-theme="light"]) .scene--narrow {
      --veil: var(--veil-wide);
    }

    .scene__frame::after {
      background: var(--veil), var(--veil-foot);
    }

    /* Fit to height: the picture stands at the screen's height on the
       right, as wide as its proportions allow (times a light zoom, which
       trims only its top and foot); the veil is solid up to it and fades
       across its left part, so it has no edge. */
    .scene--fit-height {
      --art-w: calc((100dvh - var(--header-h) - var(--thread-h)) * var(--scene-ratio) * var(--scene-zoom));
      --veil: linear-gradient(
        to right,
        var(--surface) calc(100% - var(--art-w)),
        color-mix(in srgb, var(--surface) 65%, transparent) calc(100% - var(--art-w) * 0.9),
        color-mix(in srgb, var(--surface) 20%, transparent) calc(100% - var(--art-w) * 0.78),
        transparent calc(100% - var(--art-w) * 0.66)
      );
    }

    /* A cover picture may be narrowed and pushed right (`coverWidth`). */
    .scene--fit-cover .scene__frame :global(picture) {
      width: calc(100% * var(--scene-cover));
      margin-left: auto;
    }

    .scene--fit-height .scene__frame :global(picture) {
      margin-left: auto;
      width: min(100%, var(--art-w));
    }

    /* A short page still shows the whole picture: at least a screen tall. */
    :global(.scene-content) {
      min-height: calc(100dvh - var(--header-h) - var(--thread-h));
    }

    /* Page blocks (.container) inside a .scene-content wrapper keep to the
       veiled left: 38rem of content, aligned with the page's container. */
    :global(.scene-content > .container) {
      max-width: calc(38rem + 2 * var(--gutter));
      margin-left: max(0px, (100% - var(--container)) / 2);
      margin-right: auto;
    }
  }
</style>
