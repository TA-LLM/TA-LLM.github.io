---
/**
 * Theme toggle (taste.md D1): ink by default, light as a real alternative.
 * Always visible in the header bar, on desktop and in the mobile sticky bar.
 * The visible label and icon follow `data-theme` through CSS, so they are
 * right from the first paint; the script only keeps the accessible name,
 * the browser metas and storage in sync.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to light theme">
  <svg class="theme-toggle__icon when-dark" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M10 1.5v2.5M10 16v2.5M1.5 10H4M16 10h2.5M4 4l1.8 1.8M14.2 14.2L16 16M4 16l1.8-1.8M14.2 5.8L16 4"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
  <svg class="theme-toggle__icon when-light" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <path
      d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
  </svg>
  <span class="theme-toggle__text label" aria-hidden="true">
    <span class="when-dark">Light</span><span class="when-light">Dark</span>
  </span>
</button>

<script>
  const KEY = "ta-llm-theme";
  const THEME_COLOUR = { dark: "#0F1420", light: "#F3EEE4" } as const;
  type Theme = keyof typeof THEME_COLOUR;

  const root = document.documentElement;
  const current = (): Theme => (root.dataset.theme === "light" ? "light" : "dark");

  function apply(theme: Theme): void {
    root.dataset.theme = theme;
    document.querySelector('meta[name="color-scheme"]')?.setAttribute("content", theme);
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", THEME_COLOUR[theme]);
    const label = theme === "dark" ? "Switch to light theme" : "Switch to dark theme";
    for (const button of document.querySelectorAll("[data-theme-toggle]")) {
      button.setAttribute("aria-label", label);
    }
  }

  apply(current());

  /* The new theme spreads from the button as a circle (View Transitions).
     Without the API, or under reduced motion, it simply switches. */
  function switchTo(next: Theme, origin: HTMLElement): void {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      apply(next);
      return;
    }
    root.classList.add("theme-switching");
    if (!document.startViewTransition) {
      apply(next);
      window.setTimeout(() => root.classList.remove("theme-switching"), 700);
      return;
    }
    const box = origin.getBoundingClientRect();
    const x = box.left + box.width / 2;
    const y = box.top + box.height / 2;
    const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
    const transition = document.startViewTransition(() => apply(next));
    transition.ready
      .then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 700, easing: "cubic-bezier(0.16, 1, 0.3, 1)", pseudoElement: "::view-transition-new(root)" },
        );
      })
      .catch(() => {});
    transition.finished.finally(() => root.classList.remove("theme-switching"));
  }

  for (const button of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next: Theme = current() === "dark" ? "light" : "dark";
      switchTo(next, button);
      try {
        window.localStorage.setItem(KEY, next);
      } catch {
        // Storage unavailable (private mode, blocked site data): the choice
        // simply lasts for this page view.
      }
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-width: var(--target);
    min-height: var(--target);
    padding: 0 var(--space-xs);
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-surface);
    color: var(--text);
    cursor: pointer;
    touch-action: manipulation;
  }

  .theme-toggle:hover {
    border-color: var(--text);
  }

  .theme-toggle__icon {
    flex: none;
  }

  /* The label is shown from the desktop bar up; on the phone the icon alone
     carries it, with the accessible name on the button. */
  .theme-toggle__text {
    display: none;
  }

  @media (min-width: 64rem) {
    .theme-toggle__text {
      display: inline;
    }
  }

  :global(:root[data-theme="light"]) .when-dark,
  :global(:root:not([data-theme="light"])) .when-light {
    display: none;
  }

  /* During the circular reveal, the old page stays still underneath. */
  :global(html.theme-switching::view-transition-old(root)),
  :global(html.theme-switching::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle {
      transition: border-color var(--dur-fast) var(--ease);
    }

    /* On a switch, the icon that appears turns in. */
    :global(html.theme-switching) .theme-toggle__icon {
      animation: toggle-icon-in 600ms var(--ease) both;
    }
  }

  @keyframes toggle-icon-in {
    from {
      opacity: 0;
      transform: rotate(-90deg) scale(0.6);
    }
  }
</style>
