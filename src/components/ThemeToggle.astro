---
/**
 * Theme toggle (taste.md D1): ink by default, light as a real alternative.
 * Always visible in the header bar, on desktop and in the mobile sticky bar.
 * The visible label and icon follow `data-theme` through CSS, so they are
 * right from the first paint; the script only keeps the accessible name,
 * the browser metas and storage in sync.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to light theme">
  <svg class="theme-toggle__icon when-dark" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M10 1.5v2.5M10 16v2.5M1.5 10H4M16 10h2.5M4 4l1.8 1.8M14.2 14.2L16 16M4 16l1.8-1.8M14.2 5.8L16 4"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
  <svg class="theme-toggle__icon when-light" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <path
      d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
  </svg>
  <span class="theme-toggle__text label" aria-hidden="true">
    <span class="when-dark">Light</span><span class="when-light">Dark</span>
  </span>
</button>

<script>
  const KEY = "ta-llm-theme";
  const THEME_COLOUR = { dark: "#0F1420", light: "#F3EEE4" } as const;
  type Theme = keyof typeof THEME_COLOUR;

  const root = document.documentElement;
  const current = (): Theme => (root.dataset.theme === "light" ? "light" : "dark");

  function apply(theme: Theme): void {
    root.dataset.theme = theme;
    document.querySelector('meta[name="color-scheme"]')?.setAttribute("content", theme);
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", THEME_COLOUR[theme]);
    const label = theme === "dark" ? "Switch to light theme" : "Switch to dark theme";
    for (const button of document.querySelectorAll("[data-theme-toggle]")) {
      button.setAttribute("aria-label", label);
    }
  }

  apply(current());

  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next: Theme = current() === "dark" ? "light" : "dark";
      apply(next);
      try {
        window.localStorage.setItem(KEY, next);
      } catch {
        // Storage unavailable (private mode, blocked site data): the choice
        // simply lasts for this page view.
      }
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-width: var(--target);
    min-height: var(--target);
    padding: 0 var(--space-xs);
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-surface);
    color: var(--text);
    cursor: pointer;
    touch-action: manipulation;
  }

  .theme-toggle:hover {
    border-color: var(--text);
  }

  .theme-toggle__icon {
    flex: none;
  }

  /* The label is shown from the desktop bar up; on the phone the icon alone
     carries it, with the accessible name on the button. */
  .theme-toggle__text {
    display: none;
  }

  @media (min-width: 64rem) {
    .theme-toggle__text {
      display: inline;
    }
  }

  :global(:root[data-theme="light"]) .when-dark,
  :global(:root:not([data-theme="light"])) .when-light {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle {
      transition: border-color var(--dur-fast) var(--ease);
    }
  }
</style>
