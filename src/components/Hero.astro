---
/**
 * Home hero (synthesis §3, taste.md D5/D7).
 * - The question is the only message: no call to action, one discreet mono
 *   link onward to the research themes.
 * - The headline reveals once, word by word, on the site's single stagger
 *   (index × --stagger-step); the full sentence is also in a visually hidden
 *   span, so assistive technology reads it whole.
 * - Motion: the glass comes into focus on entrance (base.css media motion,
 *   "focus": no loop of its own, the video already moves); the poster
 *   fades out once the video plays; leaving the hero, the glass recedes with
 *   the scroll (CSS scroll-driven, where supported). None under reduced motion.
 * - The right column is a looping video of an hourglass (AI-generated, 5 s,
 *   seamless; encoded by scripts/prepare-hero-video.mjs), decorative and hidden from assistive technology. It plays only
 *   while on-screen in a visible tab and never under reduced motion, where the
 *   poster (its first frame) stands still in its place.
 * - The hero stays an ink surface in both themes. The video's background is
 *   darker than ink; `mix-blend-mode: lighten` over an ink ground lifts it to
 *   exactly ink, so the frame has no edge to hide.
 */
import { getImage } from "astro:assets";
import Button from "./Button.astro";
import Tag from "./Tag.astro";
import posterSource from "../assets/hero/hourglass-poster.png";

const poster = await getImage({ src: posterSource, format: "webp", width: 480 });

const words = ["Large", "Language", "Models:", "a", "matter", "of", "time"];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid container">
    <div class="hero__text">
      <p class="label muted">TA-LLM · Research project, 2026–2029</p>
      <h1 id="hero-title" class="hero__title">
        <span class="visually-hidden">Large Language Models: a matter of time?</span>
        <span aria-hidden="true">
          {
            words.map((word, i) => (
              <>
                <span class="hero__word" style={`--i: ${i}`}>
                  {word}
                  {i === words.length - 1 && <span class="hero__q"><span class="hero__q-hook">?</span><span class="hero__q-dot" data-hero-q>?</span></span>}
                </span>
                {i < words.length - 1 && " "}
              </>
            ))
          }
        </span>
      </h1>
      <ul role="list" class="tags hero__tags" aria-label="The project in brief">
        <li><Tag variant="solid" icon="landmark">Funded by MUR · FIS 2</Tag></li>
        <li><Tag icon="calendar-range">2026 – 2029</Tag></li>
        <li><Tag icon="school">Politecnico di Torino</Tag></li>
      </ul>
      <Button class="hero__cta" href="/research/" arrow>Research themes</Button>
    </div>

    <div class="hero__visual" aria-hidden="true" data-media-motion="focus" data-hero-visual>
      <img class="hero__poster" src={poster.src} alt="" width="480" height="720" decoding="async" />
      <video
        class="hero__video"
        poster={poster.src}
        width="480"
        height="720"
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="none"
        data-hero-video
      >
        <source src="/hero/hourglass.webm" type='video/webm; codecs="av01.0.04M.08"' />
        <source src="/hero/hourglass.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<script>
  import { onReducedMotionChange, prefersReducedMotion, whenVisible } from "../scripts/motion";

  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (video) {
    let visible = false;
    let reduced = prefersReducedMotion();
    const update = () => {
      if (visible && !reduced) {
        video.play().catch(() => {});
      } else {
        video.pause();
        if (reduced) video.currentTime = 0;
      }
    };
    // The poster sits over the video until the first frame plays, then fades
    // out, so the hand-over from still to moving never shows a jump.
    video.addEventListener("playing", () => video.closest("[data-hero-visual]")?.classList.add("is-playing"), {
      once: true,
    });
    // The "?"'s dot is a grain of sand: once per loop of the glass it sinks a
    // little and fades, as if falling through the neck, then a new one forms
    // in its place. Driven by the video's own clock, so it stays locked to
    // the footage; still whenever the video is paused or motion is reduced.
    const dot = document.querySelector<HTMLElement>("[data-hero-q]");
    if (dot && typeof dot.animate === "function") {
      let fall: Animation | undefined;
      let period = 0;
      const sync = () => {
        if (!fall || !period) return;
        fall.currentTime = (video.currentTime * 1000) % period;
      };
      const tick = () => {
        sync();
        if (!video.paused) requestAnimationFrame(tick);
      };
      video.addEventListener("playing", () => {
        if (reduced || !video.duration) return;
        period = video.duration * 1000;
        fall ??= dot.animate(
          [
            { transform: "translateY(0)", opacity: 1, offset: 0 },
            { transform: "translateY(0)", opacity: 1, offset: 0.1, easing: "cubic-bezier(0.55, 0, 0.85, 0.35)" },
            { transform: "translateY(0.16em)", opacity: 0, offset: 0.3 },
            { transform: "translateY(0)", opacity: 0, offset: 0.36, easing: "cubic-bezier(0.25, 0, 0.25, 1)" },
            { transform: "translateY(0)", opacity: 1, offset: 0.62 },
            { transform: "translateY(0)", opacity: 1, offset: 1 },
          ],
          { duration: period, iterations: Infinity },
        );
        fall.pause();
        requestAnimationFrame(tick);
      });
      video.addEventListener("pause", () => sync());
      onReducedMotionChange((isReduced) => {
        if (!isReduced) return;
        fall?.cancel();
        fall = undefined;
      });
    }

    whenVisible(video, (isVisible) => {
      visible = isVisible;
      update();
    });
    onReducedMotionChange((isReduced) => {
      reduced = isReduced;
      update();
    });
  }
</script>

<style>
  /* An ink surface in both themes: the roles are re-pointed to their ink
     values locally, so the photo and the text never change ground. */
  .hero {
    --surface: var(--ink);
    --text: var(--paper);
    --text-muted: var(--paper-muted);
    --accent-text: var(--amber);
    --thread-fill: var(--amber);
    --focus: var(--amber);
    --tag-soft-bg: #312B25;
    --tag-soft-text: var(--amber);
    --tag-soft-rule: var(--amber-deep);
    color-scheme: dark;

    padding-block: var(--space-xl) var(--space-2xl);
    background: var(--surface);
    color: var(--text);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--space-xl);
      min-height: min(88dvh, 56rem);
    }
  }

  .hero__text {
    display: grid;
    gap: var(--space-m);
    align-content: center;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--hero-title-size);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 14ch;
  }

  .hero__word {
    display: inline-block;
  }

  /* One accent on this view: the question mark shares the amber of the sand. */
  /* The "?" is drawn twice, clipped apart: the hook stays, the dot (a grain
     of sand, script above) can fall on its own. The split sits in the gap
     between Gelasio's hook and dot: 63.5% down the line box (measured at
     the headline's line height). */
  .hero__q {
    position: relative;
    display: inline-block;
    color: var(--accent-text);
  }

  .hero__q-hook {
    display: block;
    clip-path: inset(-0.2em -0.2em 36.5% -0.2em);
  }

  .hero__q-dot {
    position: absolute;
    inset: 0;
    clip-path: inset(63.5% -0.2em -0.4em -0.2em);
  }

  /* The one button of the page, and the site's first action. */
  .hero__cta {
    justify-self: start;
    min-height: var(--target);
  }

  /* The video is a 2:3 column around the glass, set on an ink ground a little
     taller than itself, so the glass never touches an edge. Lighten lifts the video's darker background
     to exactly ink; the edge fades only catch the glow around the glass. */
  .hero__visual {
    --visual-height: min(calc(100dvh - 11rem), 54rem);

    display: grid;
    align-content: center;
    justify-self: center;
    width: min(100%, calc(var(--visual-height) * 480 / 820));
    aspect-ratio: 480 / 820;
    background: var(--ink);
    mask-image:
      linear-gradient(to right, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent);
    mask-composite: intersect;
  }

  /* Stacked layout: the glass follows the headline, it does not fill the screen. */
  @media (max-width: 63.99rem) {
    .hero__visual {
      --visual-height: min(72dvh, 38rem);
    }
  }

  /* Poster and video share one grid cell; the poster is the first frame. */
  .hero__video,
  .hero__poster {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    mix-blend-mode: lighten;
  }

  .hero__poster {
    pointer-events: none;
  }

  .hero__visual.is-playing .hero__poster {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__poster {
      transition: opacity 600ms var(--ease);
    }

    /* The glass comes into focus like every page image (base.css, media
       motion), after the headline has begun to rise. */
    .hero__visual[data-media-motion] {
      transition-delay: 500ms;
    }
  }

  /* Leaving the hero, the glass recedes: it sinks slower than the page, grows
     a little smaller and dims, over the first 90% of a screen of scroll.
     Scroll-driven, CSS only; browsers without it keep the glass still. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Longhands on purpose: the `animation` shorthand resets the
         timeline, and minified together the two are dropped. */
      .hero__video,
      .hero__poster {
        animation-name: hero-recede;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 90vh;
      }

      /* The poster moves with the video but never takes the dimming: an
         animated opacity would override its fade-out and show both frames. */
      .hero__poster {
        animation-name: hero-recede-move;
      }
    }
  }

  @keyframes hero-recede {
    to {
      transform: translateY(9%) scale(0.93);
      opacity: 0.35;
    }
  }

  @keyframes hero-recede-move {
    to {
      transform: translateY(9%) scale(0.93);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__word {
      animation: hero-word var(--dur-slow) var(--ease) both;
      animation-delay: calc(200ms + var(--i) * var(--stagger-step));
    }
  }

  @keyframes hero-word {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
