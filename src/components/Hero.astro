---
/**
 * Home hero (synthesis §3, taste.md D5/D7).
 * - The question is the only message: no call to action, one discreet mono
 *   link onward to the research themes.
 * - The headline reveals once, word by word, on the site's single stagger
 *   (index × --stagger-step); the full sentence is also in a visually hidden
 *   span, so assistive technology reads it whole.
 * - The right column is a looping video of an hourglass (AI-generated, 5 s,
 *   seamless; encoded by scripts/prepare-hero-video.mjs), decorative and hidden from assistive technology. It plays only
 *   while on-screen in a visible tab and never under reduced motion, where the
 *   poster (its first frame) stands still in its place.
 * - The hero stays an ink surface in both themes. The video's background is
 *   darker than ink; `mix-blend-mode: lighten` over an ink ground lifts it to
 *   exactly ink, so the frame has no edge to hide.
 */
import { getImage } from "astro:assets";
import Icon from "./Icon.astro";
import posterSource from "../assets/hero/hourglass-poster.png";

const poster = await getImage({ src: posterSource, format: "webp", width: 480 });

const words = ["Large", "Language", "Models:", "a", "matter", "of", "time"];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid container">
    <div class="hero__text">
      <p class="label muted">TA-LLM · Research project, 2026–2029</p>
      <h1 id="hero-title" class="hero__title">
        <span class="visually-hidden">Large Language Models: a matter of time?</span>
        <span aria-hidden="true">
          {
            words.map((word, i) => (
              <>
                <span class="hero__word" style={`--i: ${i}`}>
                  {word}
                  {i === words.length - 1 && <span class="hero__q">?</span>}
                </span>
                {i < words.length - 1 && " "}
              </>
            ))
          }
        </span>
      </h1>
      <a class="hero__link label link-arrow" href="/research/">Research themes<Icon name="arrow-right" size={16} /></a>
    </div>

    <div class="hero__visual" aria-hidden="true" data-reveal data-reveal-delay="700">
      <video
        class="hero__video"
        poster={poster.src}
        width="480"
        height="720"
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="none"
        data-hero-video
      >
        <source src="/hero/hourglass.webm" type='video/webm; codecs="av01.0.04M.08"' />
        <source src="/hero/hourglass.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<script>
  import { onReducedMotionChange, prefersReducedMotion, whenVisible } from "../scripts/motion";

  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (video) {
    let visible = false;
    let reduced = prefersReducedMotion();
    const update = () => {
      if (visible && !reduced) {
        video.play().catch(() => {});
      } else {
        video.pause();
        if (reduced) video.currentTime = 0;
      }
    };
    whenVisible(video, (isVisible) => {
      visible = isVisible;
      update();
    });
    onReducedMotionChange((isReduced) => {
      reduced = isReduced;
      update();
    });
  }
</script>

<style>
  /* An ink surface in both themes: the roles are re-pointed to their ink
     values locally, so the photo and the text never change ground. */
  .hero {
    --surface: var(--ink);
    --text: var(--paper);
    --text-muted: var(--paper-muted);
    --accent-text: var(--amber);
    --thread-fill: var(--amber);
    --focus: var(--amber);
    color-scheme: dark;

    padding-block: var(--space-xl) var(--space-2xl);
    background: var(--surface);
    color: var(--text);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--space-xl);
      min-height: min(78dvh, 48rem);
    }
  }

  .hero__text {
    display: grid;
    gap: var(--space-m);
    align-content: center;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--hero-title-size);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 14ch;
  }

  .hero__word {
    display: inline-block;
  }

  /* One accent on this view: the question mark shares the amber of the sand. */
  .hero__q {
    color: var(--accent-text);
  }

  .hero__link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--target);
    color: var(--text-muted);
    text-decoration: none;
  }

  .hero__link:hover {
    color: var(--text);
  }

  /* The video is a 2:3 column around the glass, set on an ink ground a little
     taller than itself, so the glass never touches an edge. Lighten lifts the video's darker background
     to exactly ink; the edge fades only catch the glow around the glass. */
  .hero__visual {
    --visual-height: min(78dvh, 44rem);

    display: grid;
    align-content: center;
    justify-self: center;
    width: min(100%, calc(var(--visual-height) * 480 / 820));
    aspect-ratio: 480 / 820;
    background: var(--ink);
    mask-image:
      linear-gradient(to right, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent);
    mask-composite: intersect;
  }

  /* Stacked layout: the glass follows the headline, it does not fill the screen. */
  @media (max-width: 63.99rem) {
    .hero__visual {
      --visual-height: min(60dvh, 30rem);
    }
  }

  .hero__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    mix-blend-mode: lighten;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__word {
      animation: hero-word var(--dur-slow) var(--ease) both;
      animation-delay: calc(200ms + var(--i) * var(--stagger-step));
    }

    .hero__link {
      transition: color var(--dur-fast) var(--ease);
    }
  }

  @keyframes hero-word {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
