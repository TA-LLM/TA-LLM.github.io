---
/**
 * A full-bleed band of the "Neuro Noise" shader
 * (research/moodboard/_taste/shader, adapted from Paper Shaders, Apache-2.0),
 * run in WebGL by src/scripts/shader-band.ts. It replaces the dithered gold
 * band, which the user found too small in this place (2026-09-20).
 *
 * - Deep: it takes a good part of the screen, so the filaments read at their
 *   own scale rather than as a stripe of noise.
 * - A separator, never a ground for text: nothing is placed on it.
 *   Decorative, hidden from assistive technology and in forced colours.
 * - It sits on the page's own surface and fades to nothing at top and foot,
 *   so it never shows an edge, on ink or on paper. Its colours are the
 *   site's (ink, amber, pale gold), so it needs no inversion in the light
 *   theme: there it is simply lightened, as a print of the same thing.
 * - `seed` moves the field: two bands on one page are the same shader, never
 *   the same picture. `tone` picks its colours: the site's amber, or a
 *   research theme's own colour on that theme's page, where it is already
 *   the one accent.
 */
interface Props {
  seed?: number;
  tone?: "amber" | "rlaif" | "cl" | "topology" | "agentic";
}

const { seed = 1372, tone = "amber" } = Astro.props;
---

<div class="shader" aria-hidden="true">
  <canvas class="shader__canvas" data-shader-band data-seed={seed} data-tone={tone}></canvas>
</div>

<script>
  import { initShaderBands } from "../scripts/shader-band";

  initShaderBands();
</script>

<style>
  .shader {
    position: relative;
    height: clamp(16rem, 42vh, 30rem);
    background: var(--surface);
    overflow: hidden;
    /* No edge on either surface. */
    mask-image: linear-gradient(to bottom, transparent, #000 26%, #000 74%, transparent);
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
  }

  .shader__canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .shader__canvas.is-ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .shader__canvas {
      transition: opacity 800ms var(--ease);
    }
  }

  /* On paper the same light, printed: the ink ground of the shader is lifted
     to the page's own paper by `screen`, and the filaments stay amber. */
  :global(:root[data-theme="light"]) .shader__canvas {
    filter: invert(1) hue-rotate(180deg) saturate(0.9) brightness(1.02);
    mix-blend-mode: multiply;
    opacity: 0.8;
  }

  :global(:root[data-theme="light"]) .shader__canvas.is-ready {
    opacity: 0.8;
  }

  @media (forced-colors: active) {
    .shader {
      display: none;
    }
  }
</style>
