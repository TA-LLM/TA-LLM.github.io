---
import { Font } from "astro:assets";
import { LAUNCHED, SITE } from "../config/site";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{!LAUNCHED && <meta name="robots" content="noindex, nofollow" />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<!-- Both metas describe the active theme; the script below and the toggle keep
     them in sync, so browser chrome and native controls follow the theme. -->
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#0F1420" />

<!-- Runs before first paint: ink unless the visitor chose light. Every storage
     access is guarded, so blocked storage leaves the page in ink, silently. -->
<script is:inline>
  (function () {
    var theme = "dark";
    try {
      var saved = window.localStorage.getItem("ta-llm-theme");
      if (saved === "light" || saved === "dark") theme = saved;
    } catch (e) {}
    document.documentElement.dataset.theme = theme;
    var scheme = document.querySelector('meta[name="color-scheme"]');
    var colour = document.querySelector('meta[name="theme-color"]');
    if (scheme) scheme.setAttribute("content", theme);
    if (colour) colour.setAttribute("content", theme === "light" ? "#F3EEE4" : "#0F1420");
  })();
</script>

<!-- Motion (src/scripts/reveal.ts). `motion` is set before first paint, and only
     without reduced motion: it is what hides [data-reveal] elements until they
     enter. If the reveal script has not started within 2.5 s, the class is
     dropped and everything shows. Arriving through a cross-document view
     transition, whatever is on screen is shown at once: the transition is the
     entrance. -->
<script is:inline>
  (function () {
    var root = document.documentElement;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    root.classList.add("motion");
    setTimeout(function () {
      if (!window.__revealReady) root.classList.remove("motion");
    }, 2500);
    window.addEventListener("pagereveal", function (event) {
      if (!event.viewTransition) return;
      var items = document.querySelectorAll("[data-reveal]");
      for (var i = 0; i < items.length; i++) {
        var box = items[i].getBoundingClientRect();
        if (box.top < window.innerHeight && box.bottom > 0) items[i].classList.add("is-revealed", "is-instant");
      }
    });
  })();
</script>
<link rel="expect" href="#main" blocking="render" />

<Font cssVariable="--font-gelasio" preload />
<Font cssVariable="--font-ibm-plex-sans" preload />
<Font cssVariable="--font-jetbrains-mono" preload />
