---
/**
 * A page backdrop: an illustration (AI-generated, or a free-licence photo
 * graded into the palette — taste.md D4 exception) in
 * the top-right corner of the page, behind the opening, dissolved into the
 * surface so it never reads as a pasted rectangle.
 *
 * - Ink theme: the image is blended with `lighten` over an ink ground, so
 *   every pixel darker than ink becomes exactly ink — the image's own
 *   background disappears, only its light remains.
 * - Light theme: the image is inverted (hue kept), cleaned up, and blended
 *   with `multiply` over paper — its dark ground becomes paper, its light
 *   turns into ink and sepia.
 * - Masks fade it out on every side: longest towards the left (where the
 *   page title sits) and the bottom (where the content begins), short at the
 *   top and right, so no edge of the image is ever visible.
 * - Decorative: hidden from assistive technology, no alt text needed.
 * - `motion` (trial, 2026-09-19): the image comes into focus once as it
 *   enters (fade 2.2 s, sharpening 3.6 s), then breathes: an 18 s drift in
 *   scale (10%) and position, back and forth, so the picture feels alive without
 *   ever being noticed as an animation. Only transforms, filter and
 *   opacity; paused off-screen and on hidden tabs; none of it under reduced
 *   motion, where the image simply shows.
 *
 * The page's <main> is the positioning context (base.css).
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  image: ImageMetadata;
  /** Strength on ink, 0–1: lower for sources with large bright areas. */
  intensity?: number;
  /** Focus-in on entrance and a slow drift (see above). */
  motion?: boolean;
}

const { image, intensity = 0.85, motion = false } = Astro.props;
---

<div
  class:list={["backdrop", { "backdrop--motion": motion }]}
  aria-hidden="true"
  style={`--backdrop-intensity: ${intensity}`}
  data-backdrop-motion={motion ? "" : undefined}
>
  <Picture
    src={image}
    alt=""
    formats={["avif"]}
    fallbackFormat="webp"
    widths={[800, 1200, 1600]}
    sizes="(min-width: 64rem) 62vw, 140vw"
    loading="eager"
    fetchpriority="low"
  />
</div>

<script>
  import { onReducedMotionChange, prefersReducedMotion, whenVisible } from "../scripts/motion";

  for (const el of document.querySelectorAll<HTMLElement>("[data-backdrop-motion]")) {
    let reduced = prefersReducedMotion();
    let visible = false;
    const update = () => el.toggleAttribute("data-playing", visible && !reduced);
    whenVisible(el, (isVisible) => {
      visible = isVisible;
      if (isVisible) el.classList.add("is-in");
      update();
    });
    onReducedMotionChange((isReduced) => {
      reduced = isReduced;
      el.classList.add("is-in");
      update();
    });
  }
</script>

<style>
  .backdrop {
    position: absolute;
    top: 0;
    right: 0;
    z-index: -1;
    width: min(62vw, 72rem);
    aspect-ratio: 16 / 9;
    background: var(--surface);
    pointer-events: none;
    /* Faded on all four sides: left (towards the title) the longest, then
       the bottom (towards the content), and a short fade at the top and the
       right, so an image that runs to its edges still shows none. */
    mask-image:
      linear-gradient(to right, transparent 12%, #000 62%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 16%, #000 34%, transparent 74%);
    mask-composite: intersect;
    opacity: var(--backdrop-intensity);
  }

  .backdrop :global(picture),
  .backdrop :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .backdrop :global(img) {
    object-fit: cover;
    mix-blend-mode: lighten;
  }

  /* Inverted with the hue kept, then desaturated and pushed brighter and
     more contrasted: the image's navy ground would otherwise invert to a cool
     grey haze; this way it reaches white and vanishes under multiply. */
  :global(:root[data-theme="light"]) .backdrop :global(img) {
    filter: invert(1) hue-rotate(180deg) saturate(0.6) brightness(1.12) contrast(1.2);
    mix-blend-mode: multiply;
  }

  /* Phones: the illustration is shifted right, partly off-screen, and
     dimmed, so the wrapping title never sits on its brightest part. */
  @media (max-width: 63.99rem) {
    .backdrop {
      width: 150vw;
      right: -55vw;
      opacity: calc(var(--backdrop-intensity) * 0.4);
    }
  }

  @media (forced-colors: active) {
    .backdrop {
      display: none;
    }
  }

  /* ------------------------------------------------------------ motion */
  @media (prefers-reduced-motion: no-preference) {
    /* Entrance: out of focus and faint until it enters, then settles. The
       hidden state exists only under html.motion (Head.astro). */
    :global(html.motion) .backdrop--motion:not(.is-in) {
      opacity: 0;
      filter: blur(28px);
    }

    /* Slow enough to be seen: the picture fades in, then sharpens. Gentle,
       symmetric curves here, not the site's fast-out --ease, which would
       spend most of the change in the first few hundred milliseconds. */
    .backdrop--motion {
      transition:
        opacity 2400ms cubic-bezier(0.4, 0, 0.2, 1) 150ms,
        filter 4000ms cubic-bezier(0.45, 0, 0.25, 1) 150ms;
    }

    /* The drift: on the image itself, so its blending is untouched. The
       mask clips the scaled image to the frame. */
    .backdrop--motion :global(img) {
      transform-origin: 70% 40%;
      animation: backdrop-drift 18s ease-in-out infinite alternate;
      animation-play-state: paused;
    }

    .backdrop--motion[data-playing] :global(img) {
      animation-play-state: running;
    }
  }

  @keyframes backdrop-drift {
    from {
      transform: scale(1) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.1) translate3d(-3%, 1.5%, 0);
    }
  }
</style>
