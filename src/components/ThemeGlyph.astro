---
/**
 * The four theme glyphs, each drawn from the idea at the centre of its theme
 * text (chosen 2026-09-18 from three candidates each). 48×48 grid; the stroke
 * stays 1.5px at any size (non-scaling), matching the utility icons.
 *
 *   agentic   — the user's own icon (2026-09-20): an AI agent's head, a chip
 *               in its mind, drawn as a mask so only its colour is ours
 *   topology  — balls grow around points until a ring closes around a hole;
 *               the long bar is the hole's lifetime, the short one is noise
 *               (persistent topological structures)
 *   cl        — a learning curve rises at each task boundary and the earlier
 *               ones stay high (learning without catastrophic forgetting)
 *   rlaif     — the user's own icon (2026-09-20): a reinforcement loop, drawn
 *               as a mask so only its colour is ours
 *
 * Colour is `currentColor`: the caller decides when the glyph takes its theme
 * colour (one accent per view). With `animated`, only the element that carries
 * the idea moves, slowly; under reduced motion the glyph is static. The two
 * supplied icons are bitmaps used exactly as they are (the user's rule), so
 * they take the colour but not the motion: they are painted through a mask,
 * the same technique as the institution logos.
 */
import agenticIcon from "../assets/theme-icons/agentic.webp";
import rlaifIcon from "../assets/theme-icons/rlaif.webp";

/** The themes drawn from the user's own artwork, by mask. */
const SUPPLIED = { agentic: agenticIcon, rlaif: rlaifIcon } as const;

interface Props {
  theme: "agentic" | "topology" | "cl" | "rlaif";
  size?: number;
  /** Always animated (the theme page's accent). */
  animated?: boolean;
  /** Animated only while an ancestor `[data-glyph-host]` is hovered, focused
      or marked `[data-active]`. */
  hover?: boolean;
  class?: string;
}

const { theme, size = 48, animated = false, hover = false, class: className } = Astro.props;

const supplied = theme in SUPPLIED ? SUPPLIED[theme as keyof typeof SUPPLIED] : undefined;
// Several glyphs of the same theme can share a page: each mask needs its own id.
const maskId = `glyph-mask-${theme}-${Math.random().toString(36).slice(2, 8)}`;

// Eight points on the topology ring, starting at the top.
const ring = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * 2 * Math.PI - Math.PI / 2;
  return { x: +(24 + 11 * Math.cos(a)).toFixed(2), y: +(18 + 11 * Math.sin(a)).toFixed(2) };
});
---

<svg
  class:list={["glyph", `glyph--${theme}`, { "glyph--animated": animated, "glyph--hover": hover }, className]}
  viewBox="0 0 48 48"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    supplied && (
      <>
        <mask id={maskId}>
          <image href={supplied.src} x="2" y="2" width="44" height="44" preserveAspectRatio="xMidYMid meet" />
        </mask>
        <rect x="0" y="0" width="48" height="48" fill="currentColor" stroke="none" mask={`url(#${maskId})`} />
      </>
    )
  }
  {
    theme === "topology" && (
      <>
        {ring.map(({ x, y }) => (
          <circle class="glyph__ball" cx={x} cy={y} r="4.3" fill="currentColor" stroke="none" />
        ))}
        {ring.map(({ x, y }) => (
          <circle cx={x} cy={y} r="1.6" fill="currentColor" stroke="none" />
        ))}
        <path class="glyph__reveal" d="M8 38h32" />
        <path class="glyph__blink" d="M8 44h8" />
      </>
    )
  }
  {
    theme === "cl" && (
      <>
        <path class="glyph__faint" d="M18 8v34M30 8v34" stroke-dasharray="1.5 3" />
        <path class="glyph__faint" d="M6 42h38" />
        <g class="glyph__reveal">
          <path d="M6 38c3 0 4-24 8-24h30" />
          <path d="M18 38c3 0 4-20 8-20h18" />
          <path d="M30 38c3 0 4-16 8-16h6" />
        </g>
      </>
    )
  }
</svg>

<style>
  .glyph {
    flex: none;
    overflow: visible;
  }

  .glyph :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .glyph__faint {
    opacity: 0.35;
  }

  .glyph__ball {
    opacity: 0.14;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Steps light up in turn: the agent's loop (the tool with the act step),
       or the preference checks along the series. */
    .glyph--animated .glyph__step,
    :global([data-glyph-host]:is(:hover, :focus-within, [data-active])) .glyph--hover .glyph__step {
      animation: glyph-step 3.6s ease-in-out infinite;
    }

    .glyph--animated .glyph__step--2,
    :global([data-glyph-host]:is(:hover, :focus-within, [data-active])) .glyph--hover .glyph__step--2 {
      animation-delay: 1.2s;
    }

    .glyph--animated .glyph__step--3,
    :global([data-glyph-host]:is(:hover, :focus-within, [data-active])) .glyph--hover .glyph__step--3 {
      animation-delay: 2.4s;
    }

    /* Filtration: the balls grow until the ring closes, while the hole's bar
       is drawn; the noise bar is born and dies. */
    .glyph--animated .glyph__ball,
    :global([data-glyph-host]:is(:hover, :focus-within, [data-active])) .glyph--hover .glyph__ball {
      transform-box: fill-box;
      transform-origin: center;
      animation: glyph-grow 5s ease-in-out infinite;
    }

    .glyph--animated .glyph__blink,
    :global([data-glyph-host]:is(:hover, :focus-within, [data-active])) .glyph--hover .glyph__blink {
      animation: glyph-blink 5s ease-in-out infinite;
    }

    /* Time advances left to right; what was drawn stays. Revealed by a clip,
       not a dash: dash lengths do not survive the non-scaling stroke. */
    .glyph--animated .glyph__reveal,
    :global([data-glyph-host]:is(:hover, :focus-within, [data-active])) .glyph--hover .glyph__reveal {
      animation: glyph-reveal 5s ease-in-out infinite;
    }
  }

  @keyframes glyph-step {
    0%,
    100% {
      opacity: 0.3;
    }
    15%,
    40% {
      opacity: 1;
    }
  }

  @keyframes glyph-grow {
    0% {
      transform: scale(0);
    }
    50%,
    100% {
      transform: scale(1);
    }
  }

  @keyframes glyph-blink {
    0%,
    100% {
      opacity: 0.15;
    }
    35%,
    60% {
      opacity: 1;
    }
  }

  @keyframes glyph-reveal {
    0% {
      clip-path: inset(-10% 100% -10% -10%);
    }
    50%,
    100% {
      clip-path: inset(-10% -10% -10% -10%);
    }
  }
</style>
