---
/**
 * Site header. One primary <nav>: inline on desktop, a full-screen overlay on
 * the phone (ELLIS pattern, synthesis §3). The theme toggle is always in the
 * bar. While the overlay is open, <main> and <footer> are made inert, so focus
 * stays in the header without a hand-written trap; Esc closes it and returns
 * focus to the menu button.
 */
import { NAV } from "../config/site";
import ProjectThread from "./ProjectThread.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<site-header>
  <header class="site-header">
    <div class="bar container">
      <a class="wordmark" href="/">
        <span class="wordmark__name">TA-LLM</span>
        <span class="visually-hidden">— home</span>
      </a>

      <nav id="site-nav" class="nav" aria-label="Primary">
        <ul role="list" class="nav__list">
          {
            NAV.map((item, i) => (
              <li style={`--i: ${i}`}>
                <a class="nav__link" href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="bar__actions">
        <ThemeToggle />
        <button type="button" class="menu-button" aria-expanded="false" aria-controls="site-nav" data-menu-button>
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <path class="menu-button__open" d="M2 6h16M2 14h16" stroke="currentColor" stroke-width="1.5"></path>
            <path class="menu-button__close" d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
          <span class="visually-hidden" data-menu-label>Open menu</span>
        </button>
      </div>
    </div>
    <ProjectThread />
  </header>
</site-header>

<script>
  class SiteHeader extends HTMLElement {
    private button!: HTMLButtonElement;
    private label!: HTMLElement;
    private desktop = window.matchMedia("(min-width: 64rem)");

    connectedCallback(): void {
      const button = this.querySelector<HTMLButtonElement>("[data-menu-button]");
      const label = this.querySelector<HTMLElement>("[data-menu-label]");
      if (!button || !label) return;
      this.button = button;
      this.label = label;

      button.addEventListener("click", () => this.setOpen(!this.isOpen()));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && this.isOpen()) {
          this.setOpen(false);
          this.button.focus();
        }
      });
      // Leaving the phone layout while the overlay is open must not leave the
      // page inert.
      this.desktop.addEventListener("change", (event) => {
        if (event.matches) this.setOpen(false);
      });
    }

    private isOpen(): boolean {
      return this.hasAttribute("data-open");
    }

    private setOpen(open: boolean): void {
      this.toggleAttribute("data-open", open);
      this.button.setAttribute("aria-expanded", String(open));
      this.label.textContent = open ? "Close menu" : "Open menu";
      document.documentElement.classList.toggle("menu-open", open);
      for (const region of document.querySelectorAll("main, body > footer, .skip-link")) {
        region.toggleAttribute("inert", open);
      }
    }
  }

  customElements.define("site-header", SiteHeader);
</script>

<style>
  site-header {
    display: contents;
  }

  /* Named, so page-to-page transitions leave the bar in place. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--surface);
    view-transition-name: site-header;
  }

  /* The theme switch reveals the whole page at once, header included. */
  :global(html.theme-switching) .site-header {
    view-transition-name: none;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    height: var(--header-h);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .bar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--target);
    height: var(--target);
    padding: 0;
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-surface);
    color: var(--text);
    cursor: pointer;
    touch-action: manipulation;
  }

  .menu-button__close {
    display: none;
  }

  site-header[data-open] .menu-button__open {
    display: none;
  }

  site-header[data-open] .menu-button__close {
    display: inline;
  }

  /* ------------------------------------------------ phone: overlay menu */
  .nav {
    display: none;
  }

  site-header[data-open] .nav {
    display: block;
    position: fixed;
    inset: calc(var(--header-h) + var(--thread-h)) 0 0 0;
    z-index: var(--z-overlay);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface);
    padding: var(--space-s) var(--gutter) var(--space-2xl);
  }

  .nav__list {
    display: flex;
    flex-direction: column;
  }

  .nav__link {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    border-bottom: var(--hairline) solid var(--rule);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    text-decoration: none;
  }

  .nav__link[aria-current="page"] {
    color: var(--accent-text);
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  /* ------------------------------------------------ desktop: inline nav */
  @media (min-width: 64rem) {
    .menu-button {
      display: none;
    }

    .nav,
    site-header[data-open] .nav {
      display: block;
      position: static;
      padding: 0;
      background: none;
      overflow: visible;
    }

    .nav__list {
      flex-direction: row;
      gap: var(--space-m);
    }

    .nav__link {
      min-height: var(--target);
      border-bottom: 0;
      font-family: var(--font-mono);
      font-size: var(--label-size);
      letter-spacing: var(--label-tracking);
      text-transform: uppercase;
      color: var(--text-muted);
      text-decoration: none;
      position: relative;
    }

    /* The underline draws in from the left and leaves to the right. */
    .nav__link::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: calc(50% + 0.95em);
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: right center;
    }

    .nav__link:hover {
      color: var(--text);
    }

    .nav__link:hover::after {
      transform: scaleX(1);
      transform-origin: left center;
    }

    /* The current-page underline is a state indicator: it needs ≥3:1, so it
       uses the text-safe accent (amber on ink, deep amber on paper). */
    .nav__link[aria-current="page"] {
      color: var(--text);
    }

    .nav__link[aria-current="page"]::after {
      background: var(--accent-text);
      transform: scaleX(1);
    }

    .bar__actions {
      margin-left: var(--space-s);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav__link {
      transition: color var(--dur-fast) var(--ease);
    }

    .nav__link::after {
      transition: transform 420ms var(--ease);
    }

    /* Phone overlay: the panel fades in and the entries follow in sequence,
       at a third of the site's stagger step (eight entries, not a list to
       read). Closing is instant: exits run faster than entrances. */
    @media (max-width: 63.99rem) {
      site-header[data-open] .nav {
        animation: menu-in var(--dur-base) var(--ease) both;
      }

      site-header[data-open] .nav__list > li {
        animation: menu-item-in 600ms var(--ease) both;
        animation-delay: calc(80ms + var(--i) * var(--stagger-step) / 3);
      }
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
