---
/**
 * An amber tag: a short fact in the mono label style, on a pill — the brand
 * colour brought into the page as small, readable markers (funding, dates,
 * counts, what is open or coming).
 *
 * - `solid`: amber fill, ink text (8.41:1 in both themes). At most one per
 *   group, for the fact that matters most.
 * - `soft` (default): an amber wash over the surface, amber text and rule
 *   (6.3:1 or better; tokens --tag-soft-*, checked by check-contrast.mjs).
 * - `dot`: a small amber dot for something open or live; it breathes slowly
 *   and never under reduced motion.
 * - Plain text, not a control: tags sit in a `<ul class="tags">` or inline.
 */
interface Props {
  variant?: "solid" | "soft";
  dot?: boolean;
  class?: string;
}

const { variant = "soft", dot = false, class: className } = Astro.props;
---

<span class:list={["tag", `tag--${variant}`, className]}>
  {dot && <span class="tag__dot" aria-hidden="true" />}
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.3rem 0.8rem;
    border: var(--hairline) solid var(--tag-soft-rule);
    border-radius: 999px;
    background: var(--tag-soft-bg);
    color: var(--tag-soft-text);
    font-family: var(--font-mono);
    font-size: var(--label-size);
    line-height: 1.3;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tag--solid {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .tag__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tag__dot {
      animation: tag-breathe 2.4s var(--ease) infinite alternate;
    }
  }

  @keyframes tag-breathe {
    from {
      opacity: 1;
    }

    to {
      opacity: 0.35;
    }
  }

  @media (forced-colors: active) {
    .tag {
      border-color: CanvasText;
    }
  }

  /* A row of tags. */
  :global(.tags) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
</style>
